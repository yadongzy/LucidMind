\\n"\n    \n    for measure in prevention_measures:\n        report += f"\\n{measure}\\n"\n    \n    report += """\n## 四、立即执行的任务\n\n### 任务1：创建回答质量检查清单\n1. 完整性检查：是否回答了所有问题？\n2. 清晰度检查：表达是否容易理解？\n3. 具体性检查：是否有具体例子或步骤？\n4. 总结检查：是否主动总结了关键点？\n\n### 任务2：建立主动总结机制\n1. 在回答末尾添加"总结："部分\n2. 主动询问"需要我进一步解释吗？"\n3. 提供下一步建议\n\n### 任务3：优化回答模板\n1. 针对常见问题创建标准回答模板\n2. 模板包含：问题分析、具体步骤、示例、总结\n3. 定期更新模板\n\n## 五、效果评估指标\n\n1. **短期（1周）**：重复提问次数减少30%\n2. **中期（1月）**：重复提问次数减少60%\n3. **长期（3月）**：重复提问次数减少90%\n\n## 六、监控机制\n\n1. 每日检查重复提问统计\n2. 每周分析重复提问模式变化\n3. 每月调整预防措施\n"""\n    \n    return report\n\ndef create_prevention_checklist():\n    """创建回答质量检查清单"""\n    \n    checklist = """# 回答质量检查清单\n版本：1.0\n创建时间：2026-02-24\n\n## 回答前检查（必须全部通过）\n\n### 1. 完整性检查\n- [ ] 是否理解了用户的真实需求？\n- [ ] 是否回答了所有显式问题？\n- [ ] 是否回答了所有隐含问题？\n- [ ] 是否提供了足够的信息？\n\n### 2. 清晰度检查\n- [ ] 表达是否简洁明了？\n- [ ] 是否有歧义或模糊之处？\n- [ ] 是否使用了用户容易理解的语言？\n- [ ] 是否有复杂的术语需要解释？\n\n### 3. 具体性检查\n- [ ] 是否有具体的步骤或方法？\n- [ ] 是否有实际的例子或案例？\n- [ ] 是否有可操作的建议？\n- [ ] 是否有明确的时间或数量？\n\n### 4. 总结检查\n- [ ] 是否主动总结了关键点？\n- [ ] 是否提供了下一步建议？\n- [ ] 是否询问了用户是否需要进一步解释？\n\n## 回答后检查\n\n### 1. 验证检查\n- [ ] 用户能否直接使用我的回答？\n- [ ] 是否需要额外步骤或信息？\n- [ ] 是否有不确定的部分需要标注？\n\n### 2. 学习检查\n- [ ] 这次回答有什么可以改进的地方？\n- [ ] 用户可能会问什么后续问题？\n- [ ] 如何让下次回答更好？\n\n## 特殊场景检查\n\n### 1. 重复提问场景\n- [ ] 用户是否问过类似问题？\n- [ ] 我之前的回答有什么不足？\n- [ ] 这次如何给出更好的回答？\n\n### 2. 复杂问题场景\n- [ ] 是否需要分解为多个步骤？\n- [ ] 是否需要使用工具辅助？\n- [ ] 是否需要搜索最新信息？\n\n## 使用说明\n\n1. 每次回答前快速扫描检查清单\n2. 针对复杂问题逐项检查\n3. 定期回顾和更新检查清单\n4. 记录检查中发现的问题和改进点\n"""\n    \n    return checklist\n\ndef main():\n    """主函数"""\n    \n    print("🚀 启动重复提问分析系统...")\n    \n    # 生成分析报告\n    report = analyze_repeat_questions()\n    \n    # 保存报告\n    with open(\'repeat_question_analysis.md\', \'w\', encoding=\'utf-8\') as f:\n        f.write(report)\n    \n    print("✅ 分析报告已保存到 repeat_question_analysis.md")\n    \n    # 创建检查清单\n    checklist = create_prevention_checklist()\n    \n    with open(\'answer_quality_checklist.md\', \'w\', encoding=\'utf-8\') as f:\n        f.write(checklist)\n    \n    print("✅ 回答质量检查清单已保存到 answer_quality_checklist.md")\n    \n    # 创建改进计划\n    improvement_plan = f"""# 重复提问改进计划\n开始时间：{datetime.now().strftime(\'%Y-%m-%d %H:%M:%S\')}\n\n## 目标\n在1周内将重复提问次数减少30%\n\n## 具体措施\n\n### 1. 立即执行（今天）\n- [x] 创建重复提问分析报告\n- [x] 创建回答质量检查清单\n- [ ] 修改回答模板，加入主动总结\n\n### 2. 本周完成\n- [ ] 实现回答前自动检查机制\n- [ ] 建立常见问题标准回答库\n- [ ] 训练主动总结能力\n\n### 3. 本月完成\n- [ ] 开发重复提问自动检测工具\n- [ ] 建立回答质量评估系统\n- [ ] 实现个性化回答优化\n\n## 监控指标\n- 每日重复提问次数\n- 用户满意度评分\n- 回答完整度评分\n\n## 负责人\nLucidMind 自我改进系统\n"""\n    \n    with open(\'repeat_question_improvement_plan.md\', \'w\', encoding=\'utf-8\') as f:\n        f.write(improvement_plan)\n    \n    print("✅ 改进计划已保存到 repeat_question_improvement_plan.md")\n    print("\\n🎯 分析完成！下一步：立即应用检查清单到实际回答中。")\n\nif __name__ == "__main__":\n    main()'})
