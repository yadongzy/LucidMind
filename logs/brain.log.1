2026-02-24 07:27:42 | lucid.brain | INFO | [task_a111c96a] 工具调用: write_file({'path': 'scripts/ollama_chat.py', 'content': '#!/usr/bin/env python3\n"""\n与Ollama进行对话的脚本\n连接Ollama API，发送问题，获取回复\n"""\n\nimport json\nimport urllib.request\nimport urllib.error\n\ndef chat_with_ollama():\n    """与Ollama进行对话"""\n    \n    # Ollama API地址\n    url = "http://localhost:11434/api/generate"\n    \n    # 请求数据\n    data = {\n        "model": "qwen3:0.6b",\n        "prompt": "你好，请介绍一下你自己。",\n        "stream": False\n    }\n    \n    # 将数据转换为JSON\n    json_data = json.dumps(data).encode(\'utf-8\')\n    \n    try:\n        # 创建请求\n        req = urllib.request.Request(\n            url,\n            data=json_data,\n            headers={\'Content-Type\': \'application/json\'}\n        )\n        \n        print(f"正在连接Ollama API: {url}")\n        print(f"使用模型: {data[\'model\']}")\n        print(f"发送的问题: {data[\'prompt\']}")\n        print("-" * 50)\n        \n        # 发送请求并获取响应\n        with urllib.request.urlopen(req) as response:\n            response_data = json.loads(response.read().decode(\'utf-8\'))\n            \n            if \'response\' in response_data:\n                print("Ollama回复:")\n                print(response_data[\'response\'])\n                \n                # 如果有其他有用信息也打印出来\n                if \'total_duration\' in response_data:\n                    print(f"\\n总耗时: {response_data[\'total_duration\']/1e9:.2f}秒")\n            else:\n                print("错误: 响应中没有\'response\'字段")\n                print(f"完整响应: {response_data}")\n                \n    except urllib.error.URLError as e:\n        print(f"连接错误: {e}")\n        print("请确保Ollama正在运行 (ollama serve)")\n    except Exception as e:\n        print(f"其他错误: {e}")\n\nif __name__ == "__main__":\n    chat_with_ollama()'})
