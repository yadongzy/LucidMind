2026-02-24 21:22:48 | lucid.brain | INFO | [teach_ex_5-1] 工具调用: write_file({'path': 'smart_learning_executor.py', 'content': '#!/usr/bin/env python3\n"""\n智能学习系统执行器\n目标：从每次交互中学习，变得更聪明\n"""\n\nimport json\nimport datetime\nimport os\nfrom pathlib import Path\n\nclass SmartLearningSystem:\n    """智能学习系统"""\n    \n    def __init__(self):\n        self.lessons_file = "lessons.json"\n        self.preferences_file = "user_preferences.json"\n        self.progress_file = "learning_progress.json"\n        self.init_system()\n    \n    def init_system(self):\n        """初始化学习系统"""\n        # 确保文件存在\n        for file in [self.lessons_file, self.preferences_file, self.progress_file]:\n            if not os.path.exists(file):\n                with open(file, \'w\', encoding=\'utf-8\') as f:\n                    if file == self.lessons_file:\n                        json.dump({"lessons": [], "total": 0}, f, ensure_ascii=False, indent=2)\n                    elif file == self.preferences_file:\n                        json.dump({"user_preferences": {}, "interaction_history": {}}, f, ensure_ascii=False, indent=2)\n                    elif file == self.progress_file:\n                        json.dump({"daily_progress": [], "weekly_summary": {}}, f, ensure_ascii=False, indent=2)\n        \n        print("✅ 智能学习系统初始化完成")\n    \n    def record_lesson(self, trigger, lesson, category, action_items=None):\n        """记录学习经验"""\n        try:\n            with open(self.lessons_file, \'r\', encoding=\'utf-8\') as f:\n                data = json.load(f)\n            \n            new_lesson = {\n                "id": len(data["lessons"]) + 1,\n                "timestamp": datetime.datetime.now().isoformat(),\n                "trigger": trigger,\n                "lesson": lesson,\n                "category": category,  # success/error/learning/preference\n                "action_items": action_items or [],\n                "next_check": (datetime.datetime.now() + datetime.timedelta(days=1)).isoformat()\n            }\n            \n            data["lessons"].append(new_lesson)\n            data["total"] = len(data["lessons"])\n            \n            with open(self.lessons_file, \'w\', encoding=\'utf-8\') as f:\n                json.dump(data, f, ensure_ascii=False, indent=2)\n            \n            print(f"✅ 经验记录成功: {trigger}")\n            return True\n            \n        except Exception as e:\n            print(f"❌ 记录经验失败: {e}")\n            return False\n    \n    def update_preferences(self, preference_type, value):\n        """更新用户偏好"""\n        try:\n            with open(self.preferences_file, \'r\', encoding=\'utf-8\') as f:\n                data = json.load(f)\n            \n            if "user_preferences" not in data:\n                data["user_preferences"] = {}\n            \n            data["user_preferences"][preference_type] = value\n            data["user_preferences"]["last_updated"] = datetime.datetime.now().isoformat()\n            \n            with open(self.preferences_file, \'w\', encoding=\'utf-8\') as f:\n                json.dump(data, f, ensure_ascii=False, indent=2)\n            \n            print(f"✅ 偏好更新成功: {preference_type} = {value}")\n            return True\n            \n        except Exception as e:\n            print(f"❌ 更新偏好失败: {e}")\n            return False\n    \n    def record_progress(self, task, status, details=None):\n        """记录学习进度"""\n        try:\n            with open(self.progress_file, \'r\', encoding=\'utf-8\') as f:\n                data = json.load(f)\n            \n            if "daily_progress" not in data:\n                data["daily_progress"] = []\n            \n            today = datetime.datetime.now().strftime("%Y-%m-%d")\n            \n            # 查找今天的进度记录\n            today_record = None\n            for record in data["daily_progress"]:\n                if record.get("date") == today:\n                    today_record = record\n                    break\n            \n            if not today_record:\n                today_record = {\n                    "date": today,\n                    "tasks": [],\n                    "lessons_learned": 0,\n                    "errors_avoided": 0\n                }\n                data["daily_progress"].append(today_record)\n            \n            # 添加任务记录\n            task_record = {\n                "task": task,\n                "status": status,  # completed/failed/in_progress\n                "timestamp": datetime.datetime.now().isoformat(),\n                "details": details or {}\n            }\n            today_record["tasks"].append(task_record)\n            \n            # 更新统计\n            if status == "completed":\n                today_record["lessons_learned"] += 1\n            elif status == "failed":\n                today_record["errors_avoided"] += 1  # 记录为避免的错误\n            \n            with open(self.progress_file, \'w\', encoding=\'utf-8\') as f:\n                json.dump(data, f, ensure_ascii=False, indent=2)\n            \n            print(f"✅ 进度记录成功: {task} - {status}")\n            return True\n            \n        except Exception as e:\n            print(f"❌ 记录进度失败: {e}")\n            return False\n    \n    def analyze_lessons(self):\n        """分析学习经验"""\n        try:\n            with open(self.lessons_file, \'r\', encoding=\'utf-8\') as f:\n                data = json.load(f)\n            \n            lessons = data.get("lessons", [])\n            \n            # 分类统计\n            categories = {}\n            for lesson in lessons:\n                cat = lesson.get("category", "unknown")\n                categories[cat] = categories.get(cat, 0) + 1\n            \n            # 最近的经验\n            recent_lessons = sorted(lessons, key=lambda x: x.get("timestamp", ""), reverse=True)[:5]\n            \n            analysis = {\n                "total_lessons": len(lessons),\n                "categories": categories,\n                "recent_lessons": recent_lessons,\n                "analysis_date": datetime.datetime.now().isoformat()\n            }\n            \n            print("📊 学习经验分析:")\n            print(f"  总经验数: {len(lessons)}")\n            print(f"  分类统计: {categories}")\n            print(f"  最近5条经验:")\n            for lesson in recent_lessons:\n                print(f"    - {lesson.get(\'trigger\')}: {lesson.get(\'lesson\')[:50]}...")\n            \n            return analysis\n            \n        except Exception as e:\n            print(f"❌ 分析经验失败: {e}")\n            return None\n    \n    def generate_daily_report(self):\n        """生成每日学习报告"""\n        try:\n            # 分析经验\n            analysis = self.analyze_lessons()\n            \n            # 读取进度\n            with open(self.progress_file, \'r\', encoding=\'utf-8\') as f:\n                progress_data = json.load(f)\n            \n            today = datetime.datetime.now().strftime("%Y-%m-%d")\n            today_progress = None\n            for record in progress_data.get("daily_progress", []):\n                if record.get("date") == today:\n                    today_progress = record\n                    break\n            \n            # 生成报告\n            report = {\n                "date": today,\n                "summary": {\n                    "total_lessons": analysis.get("total_lessons", 0) if analysis else 0,\n                    "today_lessons": today_progress.get("lessons_learned", 0) if today_progress else 0,\n                    "today_errors_avoided": today_progress.get("errors_avoided", 0) if today_progress else 0,\n                    "categories": analysis.get("categories", {}) if analysis else {}\n                },\n                "key_learnings": [],\n                "improvement_areas": [],\n                "tomorrow_plan": []\n            }\n            \n            # 添加关键学习\n            if analysis and "recent_lessons" in analysis:\n                for lesson in analysis["recent_lessons"][:3]:\n                    report["key_learnings"].append({\n                        "trigger": lesson.get("trigger"),\n                        "lesson": lesson.get("lesson")\n                    })\n            \n            # 添加改进领域（基于错误经验）\n            if analysis and "categories" in analysis:\n                error_count = analysis["categories"].get("error", 0)\n                if error_count > 0:\n                    report["improvement_areas"].append(f"减少错误（当前错误数: {error_count}）")\n            \n            # 添加明日计划\n            report["tomorrow_plan"] = [\n                "记录至少3条新经验",\n                "分析1个复杂问题",\n                "更新用户偏好数据库"\n            ]\n            \n            # 保存报告\n            report_file = f"daily_report_{today}.json"\n            with open(report_file, \'w\', encoding=\'utf-8\') as f:\n                json.dump(report, f, ensure_ascii=False, indent=2)\n            \n            print(f"📋 每日报告已生成: {report_file}")\n            return report\n            \n        except Exception as e:\n            print(f"❌ 生成报告失败: {e}")\n            return None\n\ndef main():\n    """主函数"""\n    print("🚀 启动智能学习系统...")\n    \n    # 初始化系统\n    sls = SmartLearningSystem()\n    \n    # 记录初始经验\n    sls.record_lesson(\n        trigger="启动智能学习系统",\n        lesson="建立系统化的学习机制，从每次交互中学习",\n        category="learning",\n        action_items=["创建学习系统", "实施经验记录", "建立错误预防"]\n    )\n    \n    # 更新用户偏好\n    sls.update_preferences("answer_style", "direct_and_concrete")\n    sls.update_preferences("learning_focus", ["error_reduction", "skill_improvement"])\n    \n    # 记录进度\n    sls.record_progress(\n        task="建立智能学习系统",\n        status="completed",\n        details={"components": ["经验记录", "偏好管理", "进度跟踪"]}\n    )\n    \n    # 分析经验\n    sls.analyze_lessons()\n    \n    # 生成每日报告\n    sls.generate_daily_report()\n    \n    print("🎯 智能学习系统启动完成！")\n    print("📌 下一步行动:")\n    print("  1. 每次交互后调用 record_lesson() 记录经验")\n    print("  2. 每天调用 generate_daily_report() 生成报告")\n    print("  3. 定期调用 analyze_lessons() 分析学习效果")\n\nif __name__ == "__main__":\n    main()'})
