     existing_time = existing.get(\'timestamp\', \'\')\n            new_time = lesson.get(\'timestamp\', \'\')\n            \n            if new_time > existing_time:\n                lesson_map[key] = lesson\n    \n    merged_lessons = list(lesson_map.values())\n    print(f"合并前: {len(lessons)} 条经验")\n    print(f"合并后: {len(merged_lessons)} 条经验")\n    print(f"删除了 {len(lessons) - len(merged_lessons)} 条重复经验")\n    \n    return merged_lessons\n\ndef categorize_lessons(lessons):\n    """对经验进行分类"""\n    categories = {\n        \'工具使用\': [\'run_command\', \'read_file\', \'write_file\', \'list_directory\', \'web_search\', \n                   \'grep\', \'find_files\', \'create_pptx\', \'create_excel\', \'create_csv\',\n                   \'browse_url\', \'create_chart\', \'create_image\', \'analyze_file\',\n                   \'decompose_task\', \'hello_plugin\', \'manage_plugins\', \'analyze_image\',\n                   \'text_to_speech\', \'speech_to_text\', \'introspect\', \'teaching\',\n                   \'gui_mouse\', \'gui_keyboard\', \'gui_screen\', \'gui_window\', \'cascade_communicate\'],\n        \'错误处理\': [\'失败\', \'错误\', \'异常\', \'Ralph\', \'循环\', \'超时\', \'timeout\'],\n        \'用户交互\': [\'用户\', \'说话\', \'语音\', \'朗读\', \'播放\', \'问候\', \'hello\', \'hi\'],\n        \'系统维护\': [\'自检\', \'introspect\', \'健康\', \'状态\', \'日志\', \'配置\'],\n        \'学习成长\': [\'学习\', \'经验\', \'教训\', \'改进\', \'优化\', \'变强\'],\n        \'其他\': []\n    }\n    \n    categorized = defaultdict(list)\n    \n    for lesson in lessons:\n        trigger = lesson.get(\'trigger\', \'\').lower()\n        lesson_text = lesson.get(\'lesson\', \'\').lower()\n        text = f"{trigger} {lesson_text}"\n        \n        assigned = False\n        for category, keywords in categories.items():\n            if category == \'其他\':\n                continue\n                \n            for keyword in keywords:\n                if keyword.lower() in text:\n                    categorized[category].append(lesson)\n                    assigned = True\n                    break\n            if assigned:\n                break\n        \n        if not assigned:\n            categorized[\'其他\'].append(lesson)\n    \n    print("\\n经验分类统计:")\n    for category, items in categorized.items():\n        print(f"  {category}: {len(items)} 条")\n    \n    return categorized\n\ndef main():\n    # 加载原始经验库\n    lessons_path = \'data/lessons.json\'\n    lessons = load_json_file(lessons_path)\n    \n    if not lessons:\n        print("无法加载经验库")\n        return\n    \n    # 分析经验库\n    print("=== 经验库分析 ===")\n    trigger_groups, duplicates = analyze_lessons(lessons)\n    \n    # 合并重复经验\n    print("\\n=== 合并重复经验 ===")\n    merged_lessons = merge_duplicate_lessons(lessons)\n    \n    # 分类经验\n    print("\\n=== 经验分类 ===")\n    categorized = categorize_lessons(merged_lessons)\n    \n    # 保存合并后的经验库\n    output_path = \'data/lessons_merged.json\'\n    if save_json_file(output_path, merged_lessons):\n        print(f"\\n合并后的经验库已保存到 {output_path}")\n    \n    # 保存分类统计\n    stats = {category: len(items) for category, items in categorized.items()}\n    stats_path = \'data/lessons_stats.json\'\n    save_json_file(stats_path, stats)\n    \n    # 生成总结报告\n    report = f"""经验库整理报告\n================\n\n原始经验数: {len(lessons)}\n合并后经验数: {len(merged_lessons)}\n删除重复: {len(lessons) - len(merged_lessons)} 条\n\n分类统计:\n"""\n    for category, count in stats.items():\n        report += f"  {category}: {count} 条\\n"\n    \n    report_path = \'data/lessons_report.txt\'\n    with open(report_path, \'w\', encoding=\'utf-8\') as f:\n        f.write(report)\n    \n    print(f"\\n总结报告已保存到 {report_path}")\n\nif __name__ == \'__main__\':\n    main()'})
