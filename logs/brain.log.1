 len(duplicates) > 0:\n        print(f"1. 需要清理 {len(duplicates)} 组重复经验")\n    if categories.get(\'其他\', 0) > len(lessons) * 0.3:\n        print(f"2. \'其他\'类别过多 ({categories.get(\'其他\', 0)}条)，需要重新分类")\n    \n    # 保存分析结果\n    analysis = {\n        \'total_lessons\': len(lessons),\n        \'duplicate_groups\': len(duplicates),\n        \'categories\': dict(categories),\n        \'duplicates_preview\': [\n            {\n                \'new_index\': new_idx,\n                \'old_index\': old_idx,\n                \'trigger\': trigger[:100],\n                \'new_lesson\': lessons[new_idx].get(\'lesson\', \'\')[:100],\n                \'old_lesson\': lessons[old_idx].get(\'lesson\', \'\')[:100]\n            }\n            for new_idx, old_idx, trigger in duplicates[:5]\n        ]\n    }\n    \n    with open(\'data/lessons_analysis.json\', \'w\', encoding=\'utf-8\') as f:\n        json.dump(analysis, f, ensure_ascii=False, indent=2)\n    \n    print(f"\\n分析结果已保存到: data/lessons_analysis.json")\n\nif __name__ == \'__main__\':\n    analyze_lessons()'})
