 拍照成功！")\n    else:\n        print("❌ 拍照失败")\n        return\n    \n    # 步骤2：语音播报\n    print("\\n步骤2：语音播报...")\n    message = "照片拍摄完成，已保存到指定目录"\n    speak_success = speak_message(message)\n    \n    if speak_success:\n        print("✅ 语音播报成功！")\n    else:\n        print("❌ 语音播报失败")\n    \n    print("\\n" + "=" * 50)\n    print("任务执行完成！")\n    \n    # 总结\n    if photo_success and speak_success:\n        print("✅ 所有任务成功完成！")\n        print(f"照片位置: F:/verv/LucidMind/data/webcam_photo.jpg")\n        print("请检查该文件确认照片已保存。")\n    else:\n        print("⚠️ 部分任务失败，请检查错误信息")\n\nif __name__ == "__main__":\n    main()'})
