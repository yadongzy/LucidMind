2026-02-24 07:32:22 | lucid.brain | INFO | [task_1d7fe16d] 工具调用: write_file({'path': 'error_analyzer.py', 'content': '#!/usr/bin/env python3\n"""\n错误分析模块\n自动分析错误原因，生成避坑指南\n"""\n\nimport re\nfrom datetime import datetime\n\nclass ErrorAnalyzer:\n    def __init__(self):\n        self.error_patterns = {\n            "timeout": ["超时", "timeout", "timed out", "执行时间过长"],\n            "connection": ["连接", "connection", "socket", "websocket", "网络"],\n            "permission": ["权限", "permission", "access denied", "forbidden"],\n            "not_found": ["找不到", "not found", "不存在", "no such"],\n            "invalid": ["无效", "invalid", "错误参数", "wrong parameter"],\n            "memory": ["内存", "memory", "out of memory", "内存不足"],\n            "loop": ["循环", "loop", "重复", "重复操作"]\n        }\n        \n        self.solutions = {\n            "timeout": [\n                "分解任务为更小的步骤",\n                "增加超时时间限制",\n                "优化算法复杂度",\n                "使用异步执行"\n            ],\n            "connection": [\n                "检查网络连接状态",\n                "验证服务是否运行",\n                "重试连接机制",\n                "使用备用连接方式"\n            ],\n            "permission": [\n                "检查文件/目录权限",\n                "以管理员身份运行",\n                "修改权限设置",\n                "使用正确用户账户"\n            ],\n            "not_found": [\n                "验证文件/路径是否存在",\n                "检查拼写错误",\n                "使用绝对路径",\n                "创建缺失的文件/目录"\n            ],\n            "invalid": [\n                "验证输入参数格式",\n                "检查数据类型",\n                "查看API文档",\n                "使用默认值或示例"\n            ],\n            "memory": [\n                "分批处理大数据",\n                "释放不再使用的资源",\n                "优化数据结构",\n                "增加系统内存"\n            ],\n            "loop": [\n                "设置最大重试次数",\n                "记录已尝试的方法",\n                "遇到相同错误时换策略",\n                "添加超时退出机制"\n            ]\n        }\n    \n    def analyze_error(self, error_message, context=""):\n        """分析错误消息，返回错误类型和解决方案"""\n        error_message_lower = error_message.lower()\n        \n        # 识别错误类型\n        error_type = "unknown"\n        for pattern_type, keywords in self.error_patterns.items():\n            for keyword in keywords:\n                if keyword.lower() in error_message_lower:\n                    error_type = pattern_type\n                    break\n            if error_type != "unknown":\n                break\n        \n        # 获取解决方案\n        solutions = self.solutions.get(error_type, ["检查错误日志，分析具体原因"])\n        \n        # 生成避坑指南\n        avoidance_guide = self._generate_avoidance_guide(error_type, error_message, context)\n        \n        return {\n            "error_type": error_type,\n            "error_message": error_message,\n            "solutions": solutions,\n            "avoidance_guide": avoidance_guide,\n            "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S")\n        }\n    \n    def _generate_avoidance_guide(self, error_type, error_message, context):\n        """生成避坑指南"""\n        guides = {\n            "timeout": [\n                "1. 复杂任务先分解为子任务",\n                "2. 设置合理的超时时间",\n                "3. 监控任务执行进度",\n                "4. 提供进度反馈给用户"\n            ],\n            "connection": [\n                "1. 操作前先检查连接状态",\n                "2. 实现自动重连机制",\n                "3. 准备备用连接方案",\n                "4. 记录连接失败日志"\n            ],\n            "permission": [\n                "1. 操作前检查权限需求",\n                "2. 提供清晰的权限错误提示",\n                "3. 建议正确的权限设置方法",\n                "4. 记录权限相关操作"\n            ],\n            "not_found": [\n                "1. 操作前验证资源存在性",\n                "2. 提供创建缺失资源的选项",\n                "3. 检查路径拼写和格式",\n                "4. 使用相对路径时确认工作目录"\n            ],\n            "invalid": [\n                "1. 验证所有输入参数",\n                "2. 提供参数格式示例",\n                "3. 实现参数自动修正",\n                "4. 记录参数验证失败"\n            ],\n            "memory": [\n                "1. 预估任务内存需求",\n                "2. 分批处理大数据集",\n                "3. 及时释放不再使用的资源",\n                "4. 监控内存使用情况"\n            ],\n            "loop": [\n                "1. 设置最大重试次数限制",\n                "2. 记录已尝试的方法",\n                "3. 相同错误换完全不同的策略",\n                "4. 添加超时退出机制"\n            ],\n            "unknown": [\n                "1. 详细记录错误上下文",\n                "2. 搜索类似错误解决方案",\n                "3. 尝试不同的方法",\n                "4. 向老师或文档求助"\n            ]\n        }\n        \n        return guides.get(error_type, guides["unknown"])\n    \n    def record_error_to_file(self, analysis_result, filename="error_log.json"):\n        """记录错误分析结果到文件"""\n        import json\n        \n        try:\n            # 读取现有错误日志\n            error_log = []\n            try:\n                with open(filename, \'r\', encoding=\'utf-8\') as f:\n                    error_log = json.load(f)\n            except (FileNotFoundError, json.JSONDecodeError):\n                error_log = []\n            \n            # 添加新错误\n            error_log.append(analysis_result)\n            \n            # 保存\n            with open(filename, \'w\', encoding=\'utf-8\') as f:\n                json.dump(error_log, f, ensure_ascii=False, indent=2)\n            \n            print(f"错误已记录到 {filename}")\n            return True\n        except Exception as e:\n            print(f"记录错误失败: {e}")\n            return False\n    \n    def generate_error_report(self, days=7):\n        """生成错误报告"""\n        import json\n        from datetime import datetime, timedelta\n        \n        try:\n            with open("error_log.json", \'r\', encoding=\'utf-8\') as f:\n                error_log = json.load(f)\n        except (FileNotFoundError, json.JSONDecodeError):\n            return "暂无错误记录"\n        \n        # 按时间筛选\n        cutoff_date = datetime.now() - timedelta(days=days)\n        recent_errors = []\n        \n        for error in error_log:\n            try:\n                error_time = datetime.strptime(error["timestamp"], "%Y-%m-%d %H:%M:%S")\n                if error_time >= cutoff_date:\n                    recent_errors.append(error)\n            except:\n                recent_errors.append(error)\n        \n        # 统计错误类型\n        error_stats = {}\n        for error in recent_errors:\n            error_type = error["error_type"]\n            error_stats[error_type] = error_stats.get(error_type, 0) + 1\n        \n        # 生成报告\n        report = []\n        report.append("=== 错误分析报告 ===")\n        report.append(f"统计周期: 最近{days}天")\n        report.append(f"错误总数: {len(recent_errors)}")\n        report.append("\\n错误类型分布:")\n        for error_type, count in sorted(error_stats.items(), key=lambda x: x[1], reverse=True):\n            report.append(f"  {error_type}: {count}次 ({count/len(recent_errors)*100:.1f}%)")\n        \n        if recent_errors:\n            report.append("\\n最近错误示例:")\n            for i, error in enumerate(recent_errors[:3], 1):\n                report.append(f"{i}. [{error[\'error_type\']}] {error[\'error_message\'][:100]}...")\n                report.append(f"   解决方案: {error[\'solutions\'][0]}")\n        \n        return "\\n".join(report)\n\n# 使用示例\nif __name__ == "__main__":\n    analyzer = ErrorAnalyzer()\n    \n    # 示例错误分析\n    test_errors = [\n        "任务执行超时，请检查网络连接",\n        "找不到文件: user_data.json",\n        "权限不足，无法访问目录",\n        "内存不足，无法处理大型文件"\n    ]\n    \n    for error in test_errors:\n        print(f"\\n分析错误: {error}")\n        result = analyzer.analyze_error(error)\n        print(f"错误类型: {result[\'error_type\']}")\n        print(f"解决方案: {result[\'solutions\'][0]}")\n        print(f"避坑指南: {result[\'avoidance_guide\'][0]}")\n        \n        # 记录到文件\n        analyzer.record_error_to_file(result)\n    \n    # 生成报告\n    print("\\n" + analyzer.generate_error_report())'})
