2026-02-26 13:30:49 | lucid.brain | INFO | [default] 工具调用: write_file({'content': '"""TTS Tool Adapter — 语音合成。\n\n支持两种方案：\n1. macOS say 命令（内置，无需安装）\n2. pyttsx3（跨平台，需要安装）\n\n优先使用 say 命令（更快、更稳定）。\n"""\n\nimport asyncio\nimport functools\nimport os\nimport subprocess\nimport tempfile\nfrom concurrent.futures import ThreadPoolExecutor\nfrom typing import Any\n\nfrom ports.tool_port import ToolPort\nfrom logs import get_logger\n\nlogger = get_logger("tools")\n_pool = ThreadPoolExecutor(max_workers=2)\n\n\nclass TTSAdapter(ToolPort):\n    """语音合成工具。支持文本转语音播放。"""\n\n    async def execute(self, tool_name: str, params: dict[str, Any]) -> dict[str, Any]:\n        if tool_name != "tts":\n            return {"success": False, "result": None, "error": f"Unknown tool: {tool_name}"}\n        \n        text = params.get("text", "")\n        voice = params.get("voice", None)  # 可选发音人\n        rate = params.get("rate", None)  # 语速\n        method = params.get("method", "say")  # say 或 pyttsx3\n        \n        if not text:\n            return {"success": False, "result": None, "error": "Missing required param: text"}\n        \n        try:\n            loop = asyncio.get_event_loop()\n            \n            if method == "say":\n                # macOS 内置 say 命令\n                cmd = ["say"]\n                if voice:\n                    cmd.extend(["-v", voice])\n                if rate:\n                    cmd.extend(["-r", str(rate)])\n                cmd.append(text)\n                \n                result = await loop.run_in_executor(\n                    _pool, \n                    functools.partial(subprocess.run, cmd, capture_output=True, text=True, timeout=30)\n                )\n                \n                if result.returncode != 0:\n                    return {"success": False, "result": None, "error": result.stderr}\n                \n                return {"success": True, "result": f"已朗读: {text[:50]}..."}\n            \n            elif method == "pyttsx3":\n                # pyttsx3 方案（需要安装）\n                result = await loop.run_in_executor(\n                    _pool,\n                    functools.partial(_pyttsx3_speak, text, voice, rate)\n                )\n                return result\n            \n            else:\n                return {"success": False, "result": None, "error": f"Unknown method: {method}"}\n                \n        except subprocess.TimeoutExpired:\n            return {"success": False, "result": None, "error": "TTS timeout"}\n        except Exception as e:\n            return {"success": False, "result": None, "error": str(e)}\n\n    def list_tools(self) -> list[dict[str, Any]]:\n        return [{"type": "function", "function": {\n            "name": "tts",\n            "description": "语音合成。将文本转为语音并播放（macOS say 命令）。",\n            "parameters": {"type": "object", "properties": {\n                "text": {"type": "string", "description": "要朗读的文本内容"},\n                "voice": {"type": "string", "description": "发音人（可选，macOS: Ting-Ting, Mei-Jia, Sam 等）"},\n                "rate": {"type": "number", "description": "语速（可选，macOS 默认 200）"},\n                "method": {"type": "string", "enum": ["say", "pyttsx3"], "description": "TTS方法，优先say"}\n            }, "required": ["text"]}\n        }}]\n    \n    async def list_voices(self) -> list[str]:\n        """列出可用的发音人"""\n        try:\n            result = subprocess.run(\n                ["say", "-v", "?"],\n                capture_output=True,\n                text=True,\n                timeout=10\n            )\n            voices = []\n            for line in result.stdout.split("\\n"):\n                if line.strip():\n                    voice_name = line.split()[0] if line.split() else ""\n                    if voice_name and not voice_name.startswith("="):\n                        voices.append(voice_name)\n            return voices\n        except Exception as e:\n            logger.error(f"List voices failed: {e}")\n            return []\n\n\ndef _pyttsx3_speak(text: str, voice: str = None, rate: int = None) -> dict[str, Any]:\n    """使用 pyttsx3 朗读文本"""\n    try:\n        import pyttsx3\n        engine = pyttsx3.init()\n        \n        if voice:\n            engine.setProperty("voice", voice)\n        if rate:\n            engine.setProperty("rate", rate)\n        \n        # 保存到临时文件\n        with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as f:\n            temp_file = f.name\n        \n        engine.save_to_file(text, temp_file)\n        engine.runAndWait()\n        \n        # 播放音频\n        subprocess.run(["afplay", temp_file], timeout=30)\n        \n        # 清理\n        os.unlink(temp_file)\n        \n        return {"success": True, "result": f"已朗读: {text[:50]}..."}\n    except ImportError:\n        return {"success": False, "result": None, "error": "pyttsx3 not installed. Use method=\'say\' instead."}\n    except Exception as e:\n        return {"success": False, "result": None, "error": str(e)}\n', 'path': '/Users/yadong/Documents/LucidMind/adapters/tools/tts.py'})
