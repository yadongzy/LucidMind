2026-02-22 19:06:36 | lucid.brain | INFO | [u_42722c_default] 工具调用: write_file({'path': 'camera_interactive.py', 'content': 'import cv2\nimport time\nimport os\n\nprint("=== 摄像头交互程序 ===")\nprint("1. 拍摄照片")\nprint("2. 录制短视频")\nprint("3. 实时预览")\nprint("4. 退出")\n\ndef take_photo():\n    """拍摄照片"""\n    cap = cv2.VideoCapture(0)\n    if not cap.isOpened():\n        print("无法打开摄像头")\n        return\n    \n    print("准备拍照... 3秒后拍摄")\n    for i in range(3, 0, -1):\n        print(f"{i}...")\n        time.sleep(1)\n    \n    ret, frame = cap.read()\n    if ret:\n        filename = f"photo_{int(time.time())}.jpg"\n        cv2.imwrite(filename, frame)\n        print(f"照片已保存: {filename}")\n        print(f"尺寸: {frame.shape}")\n    else:\n        print("拍照失败")\n    \n    cap.release()\n\ndef record_video():\n    """录制短视频"""\n    cap = cv2.VideoCapture(0)\n    if not cap.isOpened():\n        print("无法打开摄像头")\n        return\n    \n    fps = 30\n    duration = 5  # 5秒\n    total_frames = fps * duration\n    \n    print(f"开始录制 {duration} 秒视频...")\n    \n    # 获取第一帧来确定视频尺寸\n    ret, frame = cap.read()\n    if not ret:\n        print("无法读取视频帧")\n        cap.release()\n        return\n    \n    height, width = frame.shape[:2]\n    filename = f"video_{int(time.time())}.avi"\n    \n    # 创建视频写入器\n    fourcc = cv2.VideoWriter_fourcc(*\'XVID\')\n    out = cv2.VideoWriter(filename, fourcc, fps, (width, height))\n    \n    frame_count = 0\n    start_time = time.time()\n    \n    while frame_count < total_frames:\n        ret, frame = cap.read()\n        if ret:\n            out.write(frame)\n            frame_count += 1\n            print(f"录制中... {frame_count}/{total_frames} 帧", end=\'\\r\')\n        else:\n            break\n    \n    out.release()\n    cap.release()\n    \n    print(f"\\n视频录制完成: {filename}")\n    print(f"时长: {duration}秒, 帧率: {fps}fps, 总帧数: {frame_count}")\n\ndef preview():\n    """实时预览"""\n    cap = cv2.VideoCapture(0)\n    if not cap.isOpened():\n        print("无法打开摄像头")\n        return\n    \n    print("实时预览中... 按 \'q\' 键退出")\n    print("按 \'s\' 键保存当前帧")\n    \n    while True:\n        ret, frame = cap.read()\n        if not ret:\n            print("无法读取视频帧")\n            break\n        \n        # 显示帧\n        cv2.imshow(\'摄像头预览\', frame)\n        \n        # 按键处理\n        key = cv2.waitKey(1) & 0xFF\n        if key == ord(\'q\'):\n            break\n        elif key == ord(\'s\'):\n            filename = f"snapshot_{int(time.time())}.jpg"\n            cv2.imwrite(filename, frame)\n            print(f"快照已保存: {filename}")\n    \n    cap.release()\n    cv2.destroyAllWindows()\n\ndef main():\n    while True:\n        print("\\n请选择功能 (1-4): ", end=\'\')\n        try:\n            choice = input().strip()\n        except:\n            choice = \'4\'  # 默认退出\n        \n        if choice == \'1\':\n            take_photo()\n        elif choice == \'2\':\n            record_video()\n        elif choice == \'3\':\n            preview()\n        elif choice == \'4\':\n            print("退出程序")\n            break\n        else:\n            print("无效选择，请重新输入")\n\nif __name__ == "__main__":\n    main()'})
