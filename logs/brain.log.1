2026-02-23 23:52:00 | lucid.brain | INFO | [task_addbc617] 工具调用: write_file({'path': 'test_ollama_stability.py', 'content': '#!/usr/bin/env python3\n"""\nOllama沟通稳定性测试脚本\n验证与Ollama的多轮对话是否稳定可靠\n"""\n\nimport urllib.request\nimport urllib.error\nimport json\nimport time\nimport sys\n\ndef send_to_ollama(prompt, model="qwen3:0.6b", max_retries=3):\n    """\n    发送请求到Ollama API\n    """\n    url = "http://localhost:11434/api/generate"\n    data = {\n        "model": model,\n        "prompt": prompt,\n        "stream": False\n    }\n    \n    headers = {\n        "Content-Type": "application/json"\n    }\n    \n    for attempt in range(max_retries):\n        try:\n            # 编码数据\n            json_data = json.dumps(data).encode(\'utf-8\')\n            \n            # 创建请求\n            req = urllib.request.Request(url, data=json_data, headers=headers, method=\'POST\')\n            \n            # 发送请求并计时\n            start_time = time.time()\n            with urllib.request.urlopen(req, timeout=30) as response:\n                response_data = response.read().decode(\'utf-8\')\n                response_json = json.loads(response_data)\n                end_time = time.time()\n                \n                response_time = end_time - start_time\n                \n                if "response" in response_json:\n                    return {\n                        "success": True,\n                        "response": response_json["response"],\n                        "response_time": response_time,\n                        "attempt": attempt + 1\n                    }\n                else:\n                    return {\n                        "success": False,\n                        "error": "响应中没有\'response\'字段",\n                        "response_data": response_json,\n                        "attempt": attempt + 1\n                    }\n                    \n        except urllib.error.URLError as e:\n            if attempt < max_retries - 1:\n                print(f"  尝试 {attempt + 1} 失败: {e.reason}, 重试中...")\n                time.sleep(1)  # 等待1秒后重试\n                continue\n            else:\n                return {\n                    "success": False,\n                    "error": f"URL错误: {e.reason}",\n                    "attempt": attempt + 1\n                }\n        except Exception as e:\n            return {\n                "success": False,\n                "error": f"未知错误: {str(e)}",\n                "attempt": attempt + 1\n            }\n    \n    return {\n        "success": False,\n        "error": "达到最大重试次数",\n        "attempt": max_retries\n    }\n\ndef test_single_round():\n    """测试单轮对话"""\n    print("=" * 60)\n    print("测试1: 单轮对话")\n    print("=" * 60)\n    \n    prompt = "你好，请用中文回答：你是谁？"\n    print(f"发送: {prompt}")\n    \n    result = send_to_ollama(prompt)\n    \n    if result["success"]:\n        print(f"✓ 成功 (尝试 {result[\'attempt\']} 次)")\n        print(f"响应时间: {result[\'response_time\']:.2f}秒")\n        print(f"响应: {result[\'response\'][:100]}...")\n        return True\n    else:\n        print(f"✗ 失败 (尝试 {result[\'attempt\']} 次)")\n        print(f"错误: {result[\'error\']}")\n        return False\n\ndef test_multi_round_conversation():\n    """测试多轮对话"""\n    print("\\n" + "=" * 60)\n    print("测试2: 多轮对话（上下文相关）")\n    print("=" * 60)\n    \n    conversation = [\n        "你好，我是LucidMind。",\n        "我刚才介绍了自己，现在请你介绍一下你自己。",\n        "很好，现在我们互相认识了。你能告诉我今天的日期吗？",\n        "谢谢。最后，请用一句话总结我们的对话。"\n    ]\n    \n    all_success = True\n    total_time = 0\n    \n    for i, prompt in enumerate(conversation, 1):\n        print(f"\\n第{i}轮:")\n        print(f"发送: {prompt}")\n        \n        result = send_to_ollama(prompt)\n        \n        if result["success"]:\n            print(f"✓ 成功 (尝试 {result[\'attempt\']} 次)")\n            print(f"响应时间: {result[\'response_time\']:.2f}秒")\n            print(f"响应: {result[\'response\'][:80]}...")\n            total_time += result["response_time"]\n        else:\n            print(f"✗ 失败 (尝试 {result[\'attempt\']} 次)")\n            print(f"错误: {result[\'error\']}")\n            all_success = False\n            break\n    \n    if all_success:\n        print(f"\\n✓ 多轮对话全部成功完成")\n        print(f"总响应时间: {total_time:.2f}秒")\n        print(f"平均每轮: {total_time/len(conversation):.2f}秒")\n    \n    return all_success\n\ndef test_different_prompt_lengths():\n    """测试不同长度的提示词"""\n    print("\\n" + "=" * 60)\n    print("测试3: 不同长度提示词")\n    print("=" * 60)\n    \n    prompts = [\n        ("短提示", "你好"),\n        ("中等提示", "请用中文写一个关于人工智能的简短段落，大约50字左右。"),\n        ("长提示", "请详细解释一下机器学习中的监督学习和无监督学习的区别，包括定义、常见算法、应用场景和优缺点。请用中文回答，内容要全面但清晰易懂。")\n    ]\n    \n    all_success = True\n    \n    for name, prompt in prompts:\n        print(f"\\n测试: {name}")\n        print(f"长度: {len(prompt)} 字符")\n        \n        result = send_to_ollama(prompt)\n        \n        if result["success"]:\n            print(f"✓ 成功 (尝试 {result[\'attempt\']} 次)")\n            print(f"响应时间: {result[\'response_time\']:.2f}秒")\n            print(f"响应长度: {len(result[\'response\'])} 字符")\n        else:\n            print(f"✗ 失败 (尝试 {result[\'attempt\']} 次)")\n            print(f"错误: {result[\'error\']}")\n            all_success = False\n    \n    return all_success\n\ndef test_error_handling():\n    """测试错误处理"""\n    print("\\n" + "=" * 60)\n    print("测试4: 错误处理（使用不存在的模型）")\n    print("=" * 60)\n    \n    # 测试使用不存在的模型\n    prompt = "这是一个测试"\n    model = "non-existent-model:1.0"\n    \n    print(f"使用不存在的模型: {model}")\n    result = send_to_ollama(prompt, model=model, max_retries=1)\n    \n    if not result["success"]:\n        print(f"✓ 正确检测到错误 (尝试 {result[\'attempt\']} 次)")\n        print(f"错误信息: {result[\'error\']}")\n        return True\n    else:\n        print(f"✗ 预期失败但成功了")\n        return False\n\ndef main():\n    """主函数"""\n    print("Ollama沟通稳定性测试")\n    print("=" * 60)\n    print(f"开始时间: {time.strftime(\'%Y-%m-%d %H:%M:%S\')}")\n    print(f"目标: localhost:11434")\n    print(f"模型: qwen3:0.6b")\n    print()\n    \n    # 运行所有测试\n    tests = [\n        ("单轮对话", test_single_round),\n        ("多轮对话", test_multi_round_conversation),\n        ("不同长度提示", test_different_prompt_lengths),\n        ("错误处理", test_error_handling)\n    ]\n    \n    results = []\n    \n    for test_name, test_func in tests:\n        try:\n            success = test_func()\n            results.append((test_name, success))\n        except Exception as e:\n            print(f"\\n测试 \'{test_name}\' 发生异常: {str(e)}")\n            results.append((test_name, False))\n    \n    # 打印总结\n    print("\\n" + "=" * 60)\n    print("测试总结")\n    print("=" * 60)\n    \n    passed = 0\n    failed = 0\n    \n    for test_name, success in results:\n        status = "✓ 通过" if success else "✗ 失败"\n        print(f"{test_name}: {status}")\n        \n        if success:\n            passed += 1\n        else:\n            failed += 1\n    \n    print(f"\\n总计: {passed} 通过, {failed} 失败")\n    \n    if failed == 0:\n        print("\\n🎉 所有测试通过！Ollama沟通稳定可靠！")\n        return 0\n    else:\n        print(f"\\n⚠️  有 {failed} 个测试失败，需要进一步检查")\n        return 1\n\nif __name__ == "__main__":\n    sys.exit(main())'})
