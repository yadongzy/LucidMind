t = capital - initial_capital\n    profit_percent = (profit / initial_capital) * 100\n    \n    print(f"\\n=== 交易结果 ===")\n    print(f"初始资金: {initial_capital:.2f} CNY")\n    print(f"最终资金: {capital:.2f} CNY")\n    print(f"盈利金额: {profit:.2f} CNY")\n    print(f"盈利率: {profit_percent:.2f}%")\n    \n    # 检查是否达到目标\n    target_profit = 100.0\n    if profit >= target_profit:\n        print(f"\\n✅ 任务完成！盈利 {profit:.2f} CNY >= 目标 {target_profit} CNY")\n        return True\n    else:\n        print(f"\\n❌ 未达到目标！盈利 {profit:.2f} CNY < 目标 {target_profit} CNY")\n        return False\n\ndef main():\n    """主函数"""\n    try:\n        success = simulate_stock_trading()\n        if success:\n            sys.exit(0)\n        else:\n            sys.exit(1)\n    except Exception as e:\n        print(f"错误: {e}")\n        sys.exit(1)\n\nif __name__ == "__main__":\n    main()'})
