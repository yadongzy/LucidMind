2026-02-24 07:31:45 | lucid.brain | INFO | [task_1d7fe16d] 工具调用: write_file({'path': 'update_user_preferences.py', 'content': '#!/usr/bin/env python3\n"""\n用户偏好动态更新脚本\n用于记录用户交互模式、偏好和习惯\n"""\n\nimport json\nimport os\nfrom datetime import datetime\nfrom pathlib import Path\n\nclass UserPreferencesUpdater:\n    def __init__(self, preferences_path="user_preferences.json"):\n        self.preferences_path = Path(preferences_path)\n        self.preferences = self._load_preferences()\n    \n    def _load_preferences(self):\n        """加载现有用户偏好"""\n        if self.preferences_path.exists():\n            try:\n                with open(self.preferences_path, \'r\', encoding=\'utf-8\') as f:\n                    return json.load(f)\n            except Exception as e:\n                print(f"加载偏好文件失败: {e}")\n                return self._create_default_preferences()\n        else:\n            return self._create_default_preferences()\n    \n    def _create_default_preferences(self):\n        """创建默认偏好结构"""\n        return {\n            "user_profile": {\n                "name": "用户",\n                "preferred_language": "中文",\n                "communication_style": "直接、简洁",\n                "preferred_time": "09:00-18:00",\n                "learning_goals": [],\n                "focus_areas": []\n            },\n            "interaction_patterns": {\n                "frequent_tasks": [],\n                "common_questions": [],\n                "preferred_format": "直接回答，不铺垫",\n                "feedback_style": "直接指出问题",\n                "task_expectation": "立即执行，主动寻找任务"\n            },\n            "knowledge_base": {\n                "expertise_areas": [],\n                "learning_topics": [],\n                "saved_responses": {}\n            },\n            "error_history": {\n                "repeated_errors": [],\n                "successful_fixes": [],\n                "avoidance_patterns": []\n            },\n            "system_observations": {\n                "current_issues": [],\n                "strengths": [],\n                "improvement_areas": []\n            },\n            "last_updated": datetime.now().strftime("%Y-%m-%d %H:%M:%S")\n        }\n    \n    def record_interaction(self, task_type, task_content, success=True, notes=""):\n        """记录一次交互"""\n        # 更新频繁任务\n        if task_type not in self.preferences["interaction_patterns"]["frequent_tasks"]:\n            self.preferences["interaction_patterns"]["frequent_tasks"].append(task_type)\n        \n        # 记录学习目标\n        if "学习" in task_content or "变得更聪明" in task_content:\n            if "学习" not in self.preferences["user_profile"]["learning_goals"]:\n                self.preferences["user_profile"]["learning_goals"].append("学习")\n        \n        # 更新最后更新时间\n        self.preferences["last_updated"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")\n        \n        # 保存\n        self.save()\n        \n        print(f"已记录交互: {task_type} - {task_content[:50]}...")\n    \n    def record_error(self, error_type, error_message, fix_method=""):\n        """记录错误"""\n        error_entry = f"{error_type}: {error_message}"\n        if error_entry not in self.preferences["error_history"]["repeated_errors"]:\n            self.preferences["error_history"]["repeated_errors"].append(error_entry)\n        \n        if fix_method:\n            fix_entry = f"{error_type}修复: {fix_method}"\n            if fix_entry not in self.preferences["error_history"]["successful_fixes"]:\n                self.preferences["error_history"]["successful_fixes"].append(fix_entry)\n        \n        self.save()\n        print(f"已记录错误: {error_type}")\n    \n    def record_preference(self, preference_type, value):\n        """记录用户偏好"""\n        if preference_type == "communication_style":\n            self.preferences["user_profile"]["communication_style"] = value\n        elif preference_type == "preferred_format":\n            self.preferences["interaction_patterns"]["preferred_format"] = value\n        elif preference_type == "feedback_style":\n            self.preferences["interaction_patterns"]["feedback_style"] = value\n        \n        self.save()\n        print(f"已记录偏好: {preference_type} = {value}")\n    \n    def get_user_profile(self):\n        """获取用户画像"""\n        return self.preferences["user_profile"]\n    \n    def get_frequent_tasks(self):\n        """获取频繁任务"""\n        return self.preferences["interaction_patterns"]["frequent_tasks"]\n    \n    def get_common_errors(self):\n        """获取常见错误"""\n        return self.preferences["error_history"]["repeated_errors"]\n    \n    def save(self):\n        """保存偏好到文件"""\n        try:\n            with open(self.preferences_path, \'w\', encoding=\'utf-8\') as f:\n                json.dump(self.preferences, f, ensure_ascii=False, indent=2)\n            return True\n        except Exception as e:\n            print(f"保存偏好文件失败: {e}")\n            return False\n    \n    def generate_learning_report(self):\n        """生成学习报告"""\n        report = []\n        report.append("=== 用户学习报告 ===")\n        report.append(f"最后更新: {self.preferences[\'last_updated\']}")\n        report.append(f"学习目标: {\', \'.join(self.preferences[\'user_profile\'][\'learning_goals\'])}")\n        report.append(f"频繁任务: {\', \'.join(self.preferences[\'interaction_patterns\'][\'frequent_tasks\'][:5])}")\n        report.append(f"常见错误: {len(self.preferences[\'error_history\'][\'repeated_errors\'])} 个")\n        report.append(f"成功修复: {len(self.preferences[\'error_history\'][\'successful_fixes\'])} 个")\n        \n        return "\\n".join(report)\n\n# 使用示例\nif __name__ == "__main__":\n    updater = UserPreferencesUpdater()\n    \n    # 示例：记录一次交互\n    updater.record_interaction(\n        task_type="学习计划制定",\n        task_content="制定变得更聪明的学习计划",\n        success=True,\n        notes="建立了系统化学习机制"\n    )\n    \n    # 示例：记录错误\n    updater.record_error(\n        error_type="执行超时",\n        error_message="任务执行时间过长",\n        fix_method="分解任务，设置超时限制"\n    )\n    \n    # 生成报告\n    print(updater.generate_learning_report())'})
