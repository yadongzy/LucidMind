2026-02-24 00:12:38 | lucid.brain | INFO | [task_edbe6046] 工具调用: write_file({'path': 'ollama_multi_turn_v2.py', 'content': 'import requests\nimport json\nimport time\n\n# Ollama API地址\nOLLAMA_URL = "http://localhost:11434/api/generate"\n\ndef chat_with_ollama(prompt, model="qwen3:8b"):\n    """发送消息给Ollama并获取回复"""\n    payload = {\n        "model": model,\n        "prompt": prompt,\n        "stream": False\n    }\n    \n    try:\n        response = requests.post(OLLAMA_URL, json=payload, timeout=60)\n        if response.status_code == 200:\n            result = response.json()\n            return result.get("response", "").strip()\n        else:\n            return f"错误: HTTP {response.status_code} - {response.text}"\n    except Exception as e:\n        return f"连接错误: {str(e)}"\n\ndef multi_turn_conversation():\n    """进行多轮对话"""\n    print("=== 开始与Ollama多轮对话 ===")\n    \n    conversations = []\n    \n    # 第一轮：简单问候\n    print("\\n[第一轮] 我: 你好，请介绍一下你自己")\n    response1 = chat_with_ollama("你好，请介绍一下你自己")\n    print(f"Ollama: {response1}")\n    conversations.append(("第一轮", "你好，请介绍一下你自己", response1))\n    \n    time.sleep(1)  # 稍微等待一下\n    \n    # 第二轮：基于第一轮回复继续对话\n    print("\\n[第二轮] 我: 你能帮我写一个简单的Python函数吗？")\n    response2 = chat_with_ollama("你能帮我写一个简单的Python函数吗？")\n    print(f"Ollama: {response2}")\n    conversations.append(("第二轮", "你能帮我写一个简单的Python函数吗？", response2))\n    \n    time.sleep(1)\n    \n    # 第三轮：更具体的请求\n    print("\\n[第三轮] 我: 请写一个计算斐波那契数列的函数")\n    response3 = chat_with_ollama("请写一个计算斐波那契数列的函数")\n    print(f"Ollama: {response3}")\n    conversations.append(("第三轮", "请写一个计算斐波那契数列的函数", response3))\n    \n    time.sleep(1)\n    \n    # 第四轮：测试上下文理解（使用完整对话历史）\n    print("\\n[第四轮] 我: 刚才你写的函数能处理负数输入吗？")\n    # 为了测试上下文，我们可以将之前的对话历史也包含在prompt中\n    context_prompt = """之前的对话：\n我：请写一个计算斐波那契数列的函数\n你：""" + response3 + """\n\n现在我的问题是：刚才你写的函数能处理负数输入吗？"""\n    \n    response4 = chat_with_ollama(context_prompt)\n    print(f"Ollama: {response4}")\n    conversations.append(("第四轮", "刚才你写的函数能处理负数输入吗？", response4))\n    \n    print("\\n=== 多轮对话结束 ===")\n    \n    return conversations\n\nif __name__ == "__main__":\n    conversations = multi_turn_conversation()\n    \n    # 保存对话记录\n    with open("ollama_conversation_log_v2.txt", "w", encoding="utf-8") as f:\n        f.write("Ollama多轮对话记录 (使用qwen3:8b模型)\\n")\n        f.write("=" * 60 + "\\n")\n        for round_num, question, answer in conversations:\n            f.write(f"\\n{round_num}:\\n")\n            f.write(f"我: {question}\\n")\n            f.write(f"Ollama: {answer}\\n")\n            f.write("-" * 40 + "\\n")\n    \n    print(f"\\n对话记录已保存到: ollama_conversation_log_v2.txt")'})
