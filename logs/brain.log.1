2026-02-26 13:19:57 | lucid.brain | INFO | [default] 工具调用: write_file({'content': '"""\n语音合成模块 - 使用 macOS say 命令\n"""\nimport subprocess\nimport threading\nfrom pathlib import Path\n\n\nclass TTS:\n    """Text-to-Speech 语音合成"""\n    \n    def __init__(self):\n        self.available_voices = self._get_voices()\n        self.default_voice = "Ting-Ting"  # 中文女声\n        \n    def _get_voices(self):\n        """获取可用语音列表"""\n        result = subprocess.run(\n            ["say", "-v", "?"],\n            capture_output=True,\n            text=True\n        )\n        voices = []\n        for line in result.stdout.split("\\n"):\n            if line.strip():\n                voice_name = line.split()[0]\n                voices.append(voice_name)\n        return voices\n    \n    def speak(self, text: str, voice: str = None, async_mode: bool = True):\n        """\n        朗读文本\n        \n        Args:\n            text: 要朗读的文本\n            voice: 语音名称 (可选，默认中文女声)\n            async_mode: 是否异步执行 (True=后台播放, False=等待完成)\n        """\n        voice = voice or self.default_voice\n        \n        # 检查语音是否可用\n        if voice not in self.available_voices:\n            voice = self.default_voice\n        \n        cmd = ["say", "-v", voice, text]\n        \n        if async_mode:\n            # 后台异步播放\n            thread = threading.Thread(target=self._run_say, args=(cmd,))\n            thread.daemon = True\n            thread.start()\n        else:\n            # 同步等待完成\n            subprocess.run(cmd)\n    \n    def _run_say(self, cmd):\n        """执行 say 命令"""\n        subprocess.run(cmd)\n    \n    def speak_chinese(self, text: str, async_mode: bool = True):\n        """朗读中文文本"""\n        # 尝试使用中文语音\n        chinese_voices = ["Ting-Ting", "Mei-Jia", "Sin-ji"]\n        voice = None\n        \n        for v in chinese_voices:\n            if v in self.available_voices:\n                voice = v\n                break\n        \n        self.speak(text, voice=voice, async_mode=async_mode)\n    \n    def save_to_file(self, text: str, output_path: str, voice: str = None):\n        """保存语音到文件"""\n        voice = voice or self.default_voice\n        output_path = Path(output_path)\n        \n        cmd = ["say", "-v", voice, "-o", str(output_path), text]\n        subprocess.run(cmd)\n        \n        return output_path\n\n\n# 全局实例\n_tts_instance = None\n\ndef get_tts() -> TTS:\n    """获取 TTS 单例"""\n    global _tts_instance\n    if _tts_instance is None:\n        _tts_instance = TTS()\n    return _tts_instance\n\n\nif __name__ == "__main__":\n    # 测试\n    tts = get_tts()\n    print("可用语音数量:", len(tts.available_voices))\n    print("可用语音:", tts.available_voices[:10], "...")\n    \n    # 测试朗读\n    print("\\n测试朗读...")\n    tts.speak_chinese("你好，老大！我是 LucidMind，现在可以和你语音对话了。")\n', 'path': '/Users/yadong/Documents/LucidMind/modules/tts/tts.py'})
