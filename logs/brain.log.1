2026-02-22 19:06:47 | lucid.brain | INFO | [u_42722c_default] 工具调用: write_file({'path': 'analyze_camera_image.py', 'content': 'import cv2\nimport numpy as np\nfrom PIL import Image\nimport os\n\nprint("分析摄像头拍摄的图片...")\nprint(f"文件存在: {os.path.exists(\'camera_test.jpg\')}")\nprint(f"文件大小: {os.path.getsize(\'camera_test.jpg\')} 字节")\n\n# 用OpenCV读取\ntry:\n    img_cv = cv2.imread(\'camera_test.jpg\')\n    if img_cv is not None:\n        print(f"OpenCV读取成功 - 尺寸: {img_cv.shape}")\n        print(f"高度: {img_cv.shape[0]}, 宽度: {img_cv.shape[1]}, 通道: {img_cv.shape[2]}")\n        \n        # 计算平均颜色\n        avg_color = np.mean(img_cv, axis=(0, 1))\n        print(f"平均颜色 (BGR): {avg_color}")\n        \n        # 检查图像内容\n        gray = cv2.cvtColor(img_cv, cv2.COLOR_BGR2GRAY)\n        edges = cv2.Canny(gray, 50, 150)\n        edge_pixels = np.sum(edges > 0)\n        total_pixels = gray.shape[0] * gray.shape[1]\n        edge_ratio = edge_pixels / total_pixels\n        print(f"边缘像素比例: {edge_ratio:.4f}")\n        \n        if edge_ratio < 0.01:\n            print("图像可能比较模糊或单一颜色")\n        elif edge_ratio < 0.05:\n            print("图像有少量细节")\n        else:\n            print("图像有较多细节")\n    else:\n        print("OpenCV无法读取图片")\nexcept Exception as e:\n    print(f"OpenCV读取错误: {e}")\n\n# 用PIL读取\ntry:\n    img_pil = Image.open(\'camera_test.jpg\')\n    print(f"PIL读取成功 - 尺寸: {img_pil.size}")\n    print(f"模式: {img_pil.mode}")\n    \n    # 获取像素统计\n    pixels = list(img_pil.getdata())\n    print(f"总像素数: {len(pixels)}")\n    \n    # 检查是否为纯色或模糊\n    unique_colors = len(set(pixels[:1000]))  # 只检查前1000个像素\n    print(f"前1000像素中不同颜色数: {unique_colors}")\n    \n    if unique_colors < 10:\n        print("图像可能接近纯色或非常模糊")\n    elif unique_colors < 100:\n        print("图像颜色变化较少")\n    else:\n        print("图像颜色变化丰富")\n        \nexcept Exception as e:\n    print(f"PIL读取错误: {e}")\n\nprint("\\n=== 摄像头图像分析完成 ===")'})
