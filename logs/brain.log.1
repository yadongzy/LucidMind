messages[-1][\'content\']}")\n        print("-" * 50)\n        \n        req2 = urllib.request.Request(\n            url,\n            data=json_data2,\n            headers={\'Content-Type\': \'application/json\'}\n        )\n        \n        response2 = urllib.request.urlopen(req2, timeout=10)\n        response_data2 = json.loads(response2.read().decode(\'utf-8\'))\n        \n        # 获取第二轮回复\n        assistant_reply2 = response_data2.get(\'message\', {}).get(\'content\', \'无回复内容\')\n        print(f"Ollama回复: {assistant_reply2}")\n        \n        # 将第二轮回复添加到历史\n        messages.append({\n            "role": "assistant",\n            "content": assistant_reply2\n        })\n        \n        print("\\n" + "="*50)\n        print("完整对话记录:")\n        print("="*50)\n        \n        # 打印完整对话历史\n        for i, msg in enumerate(messages, 1):\n            role = "用户" if msg["role"] == "user" else "助手"\n            print(f"第{i}轮 [{role}]: {msg[\'content\']}")\n            print("-" * 30)\n        \n        # 打印统计信息\n        print(f"\\n对话统计:")\n        print(f"- 总轮数: {len(messages)} 条消息")\n        print(f"- 用户消息: {len([m for m in messages if m[\'role\'] == \'user\'])} 条")\n        print(f"- 助手消息: {len([m for m in messages if m[\'role\'] == \'assistant\'])} 条")\n        \n        return True\n        \n    except urllib.error.URLError as e:\n        print(f"连接错误: {e}")\n        print("请确保Ollama正在运行 (ollama serve)")\n        return False\n    except Exception as e:\n        print(f"其他错误: {e}")\n        return False\n\nif __name__ == "__main__":\n    print("开始与Ollama进行多轮对话...")\n    success = multi_round_chat_with_ollama()\n    if success:\n        print("\\n多轮对话成功完成！")\n    else:\n        print("\\n多轮对话失败。")'})
