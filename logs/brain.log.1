erns\n    \n    def get_top_errors(self, category=None, limit=5):\n        """获取最常见的错误"""\n        if category and category in self.error_patterns:\n            errors = self.error_patterns[category]\n        else:\n            # 合并所有错误\n            errors = []\n            for cat_errors in self.error_patterns.values():\n                errors.extend(cat_errors)\n        \n        # 统计频率（简化版，实际应该分析错误内容）\n        error_counts = Counter(errors)\n        return error_counts.most_common(limit)\n    \n    def generate_avoidance_rules(self):\n        """生成避免规则"""\n        rules = []\n        \n        # 重复提问避免规则\n        if self.error_patterns["重复提问"]:\n            rules.append("1. 重复提问避免规则:")\n            rules.append("   - 回答前检查历史对话")\n            rules.append("   - 对相似问题主动总结")\n            rules.append("   - 建立常见问题FAQ")\n        \n        # 工具调用失败避免规则\n        if self.error_patterns["工具调用失败"]:\n            rules.append("2. 工具调用失败避免规则:")\n            rules.append("   - 调用前验证参数格式")\n            rules.append("   - 失败后立即尝试替代方案")\n            rules.append("   - 记录工具使用最佳实践")\n        \n        # 系统错误避免规则\n        if self.error_patterns["系统错误"]:\n            rules.append("3. 系统错误避免规则:")\n            rules.append("   - 定期检查系统健康状态")\n            rules.append("   - 建立自动恢复机制")\n            rules.append("   - 监控关键指标（WebSocket、LLM）")\n        \n        # 理解错误避免规则\n        if self.error_patterns["理解错误"]:\n            rules.append("4. 理解错误避免规则:")\n            rules.append("   - 不确定时主动追问")\n            rules.append("   - 用自己的话复述确认")\n            rules.append("   - 分解复杂任务为小步骤")\n        \n        return "\\n".join(rules)\n    \n    def suggest_improvements(self):\n        """基于错误模式提出改进建议"""\n        suggestions = []\n        \n        error_counts = {cat: len(errors) for cat, errors in self.error_patterns.items()}\n        \n        # 按错误数量排序\n        sorted_cats = sorted(error_counts.items(), key=lambda x: x[1], reverse=True)\n        \n        for category, count in sorted_cats:\n  