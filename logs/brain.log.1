2026-02-25 09:15:18 | lucid.brain | INFO | [task_1085a011] 工具调用: write_file({'path': 'enhance_user_profile.py', 'content': '#!/usr/bin/env python3\n"""\n用户画像增强提取脚本\n用于从对话历史中提取更丰富的用户偏好\n"""\n\nimport json\nimport re\nfrom pathlib import Path\nfrom datetime import datetime, timedelta\n\ndef extract_preferences_from_history(history_file="data/memory/conversations.json"):\n    """从对话历史中提取用户偏好"""\n    \n    preferences = {\n        "language": "zh-CN",  # 默认中文\n        "style": "concise",   # 默认简洁\n        "format_preference": "structured",  # 默认结构化\n        "action_style": "autonomous",  # 默认主动执行\n        "tech_domains": set(),\n        "common_tools": set(),\n        "response_patterns": []\n    }\n    \n    try:\n        with open(history_file, \'r\', encoding=\'utf-8\') as f:\n            data = json.load(f)\n        \n        # 分析最近100条用户消息\n        user_messages = []\n        for conv in data.get("conversations", []):\n            for msg in conv.get("messages", []):\n                if msg.get("role") == "user":\n                    user_messages.append(msg.get("content", ""))\n        \n        # 分析最后50条消息\n        recent_messages = user_messages[-50:] if len(user_messages) > 50 else user_messages\n        \n        for msg in recent_messages:\n            msg_lower = msg.lower()\n            \n            # 语言偏好\n            if "english" in msg_lower or "英文" in msg_lower:\n                preferences["language"] = "en"\n            \n            # 风格偏好\n            if "简洁" in msg_lower or "简短" in msg_lower or "直接" in msg_lower:\n                preferences["style"] = "concise"\n            elif "详细" in msg_lower or "详尽" in msg_lower or "解释" in msg_lower:\n                preferences["style"] = "detailed"\n            \n            # 格式偏好\n            if "表格" in msg_lower:\n                preferences["format_preference"] = "table"\n            elif "列表" in msg_lower:\n                preferences["format_preference"] = "list"\n            elif "结构化" in msg_lower:\n                preferences["format_preference"] = "structured"\n            \n            # 行动风格\n            if "主动" in msg_lower or "直接做" in msg_lower or "不要问" in msg_lower:\n                preferences["action_style"] = "autonomous"\n            elif "确认" in msg_lower or "先问" in msg_lower:\n                preferences["action_style"] = "confirm_first"\n            \n            # 技术领域\n            tech_keywords = {\n                "python": "python",\n                "javascript": "javascript", \n                "java": "java",\n                "c++": "cpp",\n                "go": "go",\n                "rust": "rust",\n                "数据分析": "data_analysis",\n                "机器学习": "machine_learning",\n                "深度学习": "deep_learning",\n                "前端": "frontend",\n                "后端": "backend",\n                "数据库": "database",\n                "系统管理": "system_admin",\n                "网络": "networking",\n                "安全": "security"\n            }\n            \n            for keyword, domain in tech_keywords.items():\n                if keyword in msg_lower:\n                    preferences["tech_domains"].add(domain)\n            \n            # 常用工具\n            tool_keywords = {\n                "docker": "docker",\n                "kubernetes": "kubernetes",\n                "git": "git",\n                "vscode": "vscode",\n                "pycharm": "pycharm",\n                "jupyter": "jupyter",\n                "fastapi": "fastapi",\n                "django": "django",\n                "flask": "flask",\n                "react": "react",\n                "vue": "vue",\n                "angular": "angular",\n                "mysql": "mysql",\n                "postgresql": "postgresql",\n                "mongodb": "mongodb",\n                "redis": "redis"\n            }\n            \n            for keyword, tool in tool_keywords.items():\n                if keyword in msg_lower:\n                    preferences["common_tools"].add(tool)\n        \n        # 转换集合为列表\n        preferences["tech_domains"] = list(preferences["tech_domains"])\n        preferences["common_tools"] = list(preferences["common_tools"])\n        \n        return preferences\n        \n    except Exception as e:\n        print(f"提取偏好失败: {e}")\n        return preferences\n\ndef update_user_profile(preferences):\n    """更新用户画像文件"""\n    \n    profile_path = Path("user_profile.md")\n    \n    if not profile_path.exists():\n        print("用户画像文件不存在")\n        return\n    \n    try:\n        content = profile_path.read_text(encoding=\'utf-8\')\n        \n        # 查找工作习惯部分\n        work_habits_start = content.find("## 工作习惯")\n        if work_habits_start == -1:\n            print("未找到工作习惯部分")\n            return\n        \n        # 构建增强的工作习惯\n        enhanced_habits = "## 工作习惯\\n"\n        \n        # 风格偏好\n        if preferences["style"] == "concise":\n            enhanced_habits += "- 偏好简洁直接的回答，不要啰嗦\\n"\n        else:\n            enhanced_habits += "- 偏好详细全面的回答，需要充分解释\\n"\n        \n        # 格式偏好\n        if preferences["format_preference"] == "table":\n            enhanced_habits += "- 喜欢看到表格形式的输出\\n"\n        elif preferences["format_preference"] == "list":\n            enhanced_habits += "- 喜欢看到列表形式的输出\\n"\n        else:\n            enhanced_habits += "- 喜欢看到结构化的输出（表格、列表）\\n"\n        \n        # 行动风格\n        if preferences["action_style"] == "autonomous":\n            enhanced_habits += "- 希望大脑主动执行，不要反复确认\\n"\n        else:\n            enhanced_habits += "- 希望大脑在执行前先确认关键步骤\\n"\n        \n        # 技术领域（如果有）\n        if preferences["tech_domains"]:\n            enhanced_habits += f"- 技术关注领域: {\', \'.join(preferences[\'tech_domains\'])}\\n"\n        \n        # 常用工具（如果有）\n        if preferences["common_tools"]:\n            enhanced_habits += f"- 常用工具: {\', \'.join(preferences[\'common_tools\'])}\\n"\n        \n        # 替换原有工作习惯部分\n        # 找到下一个##标题\n        next_section_start = content.find("##", work_habits_start + 1)\n        if next_section_start == -1:\n            next_section_start = len(content)\n        \n        old_habits = content[work_habits_start:next_section_start]\n        new_content = content.replace(old_habits, enhanced_habits)\n        \n        profile_path.write_text(new_content, encoding=\'utf-8\')\n        print("用户画像已更新")\n        \n    except Exception as e:\n        print(f"更新用户画像失败: {e}")\n\ndef main():\n    """主函数"""\n    print("开始分析用户偏好...")\n    \n    # 提取偏好\n    preferences = extract_preferences_from_history()\n    \n    print("\\n提取的用户偏好:")\n    print(f"语言: {preferences[\'language\']}")\n    print(f"风格: {preferences[\'style\']}")\n    print(f"格式偏好: {preferences[\'format_preference\']}")\n    print(f"行动风格: {preferences[\'action_style\']}")\n    print(f"技术领域: {preferences[\'tech_domains\']}")\n    print(f"常用工具: {preferences[\'common_tools\']}")\n    \n    # 更新用户画像\n    update_user_profile(preferences)\n    \n    print("\\n用户画像增强完成！")\n\nif __name__ == "__main__":\n    main()'})
