2026-02-25 09:30:04 | lucid.brain | INFO | [teach_ab_test_WITHOUT_3] 工具调用: write_file({'path': 'simple_http_server.py', 'content': '#!/usr/bin/env python3\n"""\n简单的Python HTTP服务器\n支持静态文件服务和自定义路由\n"""\n\nimport http.server\nimport socketserver\nimport os\nimport sys\nfrom urllib.parse import urlparse, parse_qs\n\nclass SimpleHTTPRequestHandler(http.server.SimpleHTTPRequestHandler):\n    """自定义HTTP请求处理器"""\n    \n    def do_GET(self):\n        """处理GET请求"""\n        parsed_path = urlparse(self.path)\n        path = parsed_path.path\n        \n        # 自定义路由\n        if path == \'/\':\n            self.send_response(200)\n            self.send_header(\'Content-type\', \'text/html; charset=utf-8\')\n            self.end_headers()\n            self.wfile.write(self._generate_homepage().encode(\'utf-8\'))\n        elif path == \'/hello\':\n            self.send_response(200)\n            self.send_header(\'Content-type\', \'text/html; charset=utf-8\')\n            self.end_headers()\n            self.wfile.write(b\'<h1>Hello World!</h1><p>这是一个简单的HTTP服务器</p>\')\n        elif path == \'/api/info\':\n            self.send_response(200)\n            self.send_header(\'Content-type\', \'application/json\')\n            self.end_headers()\n            import json\n            info = {\n                \'server\': \'Simple Python HTTP Server\',\n                \'version\': \'1.0\',\n                \'path\': self.path,\n                \'client_address\': self.client_address[0]\n            }\n            self.wfile.write(json.dumps(info, indent=2).encode(\'utf-8\'))\n        elif path == \'/api/echo\':\n            # 获取查询参数\n            query_params = parse_qs(parsed_path.query)\n            message = query_params.get(\'message\', [\'\'])[0]\n            \n            self.send_response(200)\n            self.send_header(\'Content-type\', \'application/json\')\n            self.end_headers()\n            import json\n            response = {\n                \'echo\': message,\n                \'timestamp\': __import__(\'time\').time()\n            }\n            self.wfile.write(json.dumps(response).encode(\'utf-8\'))\n        else:\n            # 默认行为：静态文件服务\n            super().do_GET()\n    \n    def do_POST(self):\n        """处理POST请求"""\n        if self.path == \'/api/post\':\n            content_length = int(self.headers[\'Content-Length\'])\n            post_data = self.rfile.read(content_length)\n            \n            self.send_response(200)\n            self.send_header(\'Content-type\', \'application/json\')\n            self.end_headers()\n            \n            import json\n            try:\n                data = json.loads(post_data.decode(\'utf-8\'))\n                response = {\n                    \'status\': \'success\',\n                    \'received_data\': data,\n                    \'message\': \'数据接收成功\'\n                }\n            except:\n                response = {\n                    \'status\': \'error\',\n                    \'received_data\': post_data.decode(\'utf-8\'),\n                    \'message\': \'无法解析JSON数据\'\n                }\n            \n            self.wfile.write(json.dumps(response).encode(\'utf-8\'))\n        else:\n            self.send_response(404)\n            self.send_header(\'Content-type\', \'text/html; charset=utf-8\')\n            self.end_headers()\n            self.wfile.write(b\'<h1>404 Not Found</h1><p>POST路由不存在</p>\')\n    \n    def _generate_homepage(self):\n        """生成主页HTML"""\n        return f\'\'\'\n<!DOCTYPE html>\n<html>\n<head>\n    <title>Python HTTP 服务器</title>\n    <meta charset="utf-8">\n    <style>\n        body {{ font-family: Arial, sans-serif; margin: 40px; line-height: 1.6; }}\n        h1 {{ color: #333; }}\n        .container {{ max-width: 800px; margin: 0 auto; }}\n        .endpoint {{ background: #f5f5f5; padding: 15px; margin: 10px 0; border-radius: 5px; }}\n        code {{ background: #eee; padding: 2px 5px; border-radius: 3px; }}\n    </style>\n</head>\n<body>\n    <div class="container">\n        <h1>🚀 Python HTTP 服务器</h1>\n        <p>服务器正在运行在 <code>http://{self.server.server_address[0]}:{self.server.server_address[1]}</code></p>\n        \n        <h2>可用端点：</h2>\n        \n        <div class="endpoint">\n            <h3>GET /</h3>\n            <p>当前页面</p>\n        </div>\n        \n        <div class="endpoint">\n            <h3>GET /hello</h3>\n            <p>简单的问候页面</p>\n            <p><a href="/hello">访问 /hello</a></p>\n        </div>\n        \n        <div class="endpoint">\n            <h3>GET /api/info</h3>\n            <p>服务器信息（JSON格式）</p>\n            <p><a href="/api/info">访问 /api/info</a></p>\n        </div>\n        \n        <div class="endpoint">\n            <h3>GET /api/echo?message=你好</h3>\n            <p>回显消息</p>\n            <p><a href="/api/echo?message=Hello%20World">示例：/api/echo?message=Hello World</a></p>\n        </div>\n        \n        <div class="endpoint">\n            <h3>POST /api/post</h3>\n            <p>接收JSON数据</p>\n            <p>使用工具如curl测试：<br>\n            <code>curl -X POST -H "Content-Type: application/json" -d \'{{"name":"test"}}\' http://localhost:8000/api/post</code></p>\n        </div>\n        \n        <div class="endpoint">\n            <h3>静态文件服务</h3>\n            <p>访问服务器目录下的任何文件，例如：</p>\n            <ul>\n                <li><a href="/simple_http_server.py">/simple_http_server.py</a> - 当前脚本</li>\n                <li>其他文件：<code>/path/to/file.txt</code></li>\n            </ul>\n        </div>\n        \n        <h2>服务器信息：</h2>\n        <ul>\n            <li>Python版本: {sys.version.split()[0]}</li>\n            <li>工作目录: {os.getcwd()}</li>\n            <li>文件列表: {\', \'.join([f for f in os.listdir(\'.\') if os.path.isfile(f)][:5])}...</li>\n        </ul>\n    </div>\n</body>\n</html>\n\'\'\'\n    \n    def log_message(self, format, *args):\n        """自定义日志格式"""\n        print(f"[{self.log_date_time_string()}] {self.address_string()} - {format % args}")\n\ndef run_server(port=8000, bind=\'0.0.0.0\'):\n    """启动HTTP服务器"""\n    handler = SimpleHTTPRequestHandler\n    \n    # 设置静态文件目录为当前目录\n    os.chdir(os.path.dirname(os.path.abspath(__file__)))\n    \n    with socketserver.TCPServer((bind, port), handler) as httpd:\n        print(f"🚀 服务器启动在 http://{bind}:{port}")\n        print(f"📁 静态文件目录: {os.getcwd()}")\n        print("📋 可用端点:")\n        print("  • GET /              - 主页")\n        print("  • GET /hello         - 问候页面")\n        print("  • GET /api/info      - 服务器信息")\n        print("  • GET /api/echo      - 回显消息")\n        print("  • POST /api/post     - 接收JSON数据")\n        print("  • GET /<filename>    - 静态文件")\n        print("\\n按 Ctrl+C 停止服务器")\n        \n        try:\n            httpd.serve_forever()\n        except KeyboardInterrupt:\n            print("\\n🛑 服务器停止")\n            httpd.shutdown()\n\nif __name__ == \'__main__\':\n    import argparse\n    \n    parser = argparse.ArgumentParser(description=\'简单的Python HTTP服务器\')\n    parser.add_argument(\'-p\', \'--port\', type=int, default=8000, help=\'端口号 (默认: 8000)\')\n    parser.add_argument(\'-b\', \'--bind\', default=\'0.0.0.0\', help=\'绑定地址 (默认: 0.0.0.0)\')\n    \n    args = parser.parse_args()\n    \n    run_server(port=args.port, bind=args.bind)'})
