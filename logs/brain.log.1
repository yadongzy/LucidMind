2026-02-23 08:11:29 | lucid.brain | INFO | [task_1771805373] 工具调用: write_file({'path': 'smart_merge_lessons.py', 'content': '#!/usr/bin/env python3\nimport json\nimport re\nfrom collections import defaultdict\nimport difflib\n\ndef load_json_file(filepath):\n    """加载JSON文件"""\n    try:\n        with open(filepath, \'r\', encoding=\'utf-8\') as f:\n            return json.load(f)\n    except Exception as e:\n        print(f"加载文件 {filepath} 失败: {e}")\n        return None\n\ndef normalize_text(text):\n    """标准化文本：移除标点、转换为小写、移除多余空格"""\n    if not text:\n        return ""\n    # 转换为小写\n    text = text.lower()\n    # 移除标点符号\n    text = re.sub(r\'[^\\w\\s]\', \' \', text)\n    # 移除多余空格\n    text = re.sub(r\'\\s+\', \' \', text).strip()\n    return text\n\ndef find_similar_lessons(lessons, similarity_threshold=0.7):\n    """查找相似的经验"""\n    # 创建标准化文本\n    normalized = []\n    for i, lesson in enumerate(lessons):\n        trigger = lesson.get(\'trigger\', \'\')\n        lesson_text = lesson.get(\'lesson\', \'\')\n        combined = f"{trigger} {lesson_text}"\n        normalized.append((i, normalize_text(combined)))\n    \n    # 查找相似项\n    similar_groups = []\n    processed = set()\n    \n    for i, (idx1, text1) in enumerate(normalized):\n        if idx1 in processed:\n            continue\n            \n        group = [idx1]\n        processed.add(idx1)\n        \n        for j, (idx2, text2) in enumerate(normalized):\n            if idx2 in processed or idx1 == idx2:\n                continue\n            \n            # 计算相似度\n            similarity = difflib.SequenceMatcher(None, text1, text2).ratio()\n            if similarity > similarity_threshold:\n                group.append(idx2)\n                processed.add(idx2)\n        \n        if len(group) > 1:\n            similar_groups.append(group)\n    \n    return similar_groups\n\ndef merge_similar_lessons(lessons, similar_groups):\n    """合并相似的经验"""\n    # 创建索引映射\n    to_keep = set(range(len(lessons)))\n    merged_lessons = []\n    \n    for group in similar_groups:\n        # 选择最完整的一条作为代表\n        best_idx = group[0]\n        best_length = 0\n        \n        for idx in group:\n            trigger = lessons[idx].get(\'trigger\', \'\')\n            lesson_text = lessons[idx].get(\'lesson\', \'\')\n            length = len(trigger) + len(lesson_text)\n            \n            if length > best_length:\n                best_length = length\n                best_idx = idx\n        \n        # 保留最佳的一条\n        merged_lessons.append(lessons[best_idx])\n        \n        # 从待保留集合中移除其他项\n        for idx in group:\n            if idx != best_idx:\n                to_keep.discard(idx)\n    \n    # 添加未合并的经验\n    for idx in to_keep:\n        if idx not in [item for group in similar_groups for item in group]:\n            merged_lessons.append(lessons[idx])\n    \n    return merged_lessons\n\ndef analyze_patterns(lessons):\n    """分析经验模式"""\n    patterns = defaultdict(int)\n    \n    for lesson in lessons:\n        trigger = lesson.get(\'trigger\', \'\')\n        lesson_text = lesson.get(\'lesson\', \'\')\n        \n        # 分析常见模式\n        if \'Ralph\' in trigger or \'Ralph\' in lesson_text:\n            patterns[\'Ralph循环错误\'] += 1\n        \n        if \'text_to_speech\' in trigger or \'text_to_speech\' in lesson_text:\n            patterns[\'text_to_speech使用\'] += 1\n        \n        if \'introspect\' in trigger or \'introspect\' in lesson_text:\n            patterns[\'自省工具使用\'] += 1\n        \n        if \'失败\' in trigger or \'失败\' in lesson_text or \'错误\' in trigger or \'错误\' in lesson_text:\n            patterns[\'失败处理\'] += 1\n        \n        if \'用户\' in trigger or \'用户\' in lesson_text:\n            patterns[\'用户交互\'] += 1\n    \n    return patterns\n\ndef create_improvement_plan(patterns, total_lessons):\n    """创建改进计划"""\n    plan = []\n    \n    # 根据模式分析改进点\n    if patterns.get(\'Ralph循环错误\', 0) > 5:\n        plan.append("**高优先级**: 解决Ralph循环错误问题 - 需要优化LLM调用失败的重试机制")\n    \n    if patterns.get(\'失败处理\', 0) > 10:\n        plan.append("**高优先级**: 减少工具调用失败 - 需要更好的错误处理和替代方案")\n    \n    if patterns.get(\'text_to_speech使用\', 0) > 3:\n        plan.append("**中优先级**: 统一text_to_speech使用模式 - 创建标准操作流程")\n    \n    if patterns.get(\'自省工具使用\', 0) > 5:\n        plan.append("**中优先级**: 优化自省工具使用 - 减少不必要的自检调用")\n    \n    # 计算成功率\n    success_rate = 100 - (patterns.get(\'失败处理\', 0) / total_lessons * 100) if total_lessons > 0 else 100\n    plan.append(f"**统计**: 当前经验库中失败处理相关经验占比 {patterns.get(\'失败处理\', 0)/total_lessons*100:.1f}%，估算成功率约 {success_rate:.1f}%")\n    \n    return plan\n\ndef main():\n    # 加载经验库\n    lessons_path = \'data/lessons.json\'\n    lessons = load_json_file(lessons_path)\n    \n    if not lessons:\n        print("无法加载经验库")\n        return\n    \n    print(f"原始经验数: {len(lessons)}")\n    \n    # 分析模式\n    print("\\n=== 经验模式分析 ===")\n    patterns = analyze_patterns(lessons)\n    for pattern, count in patterns.items():\n        print(f"  {pattern}: {count} 次")\n    \n    # 查找相似经验\n    print("\\n=== 查找相似经验 ===")\n    similar_groups = find_similar_lessons(lessons, similarity_threshold=0.6)\n    print(f"找到 {len(similar_groups)} 组相似经验")\n    \n    total_similar = sum(len(group) for group in similar_groups)\n    print(f"涉及 {total_similar} 条经验")\n    \n    # 显示最大的相似组\n    if similar_groups:\n        similar_groups.sort(key=len, reverse=True)\n        print("\\n最大的相似组:")\n        for i, group in enumerate(similar_groups[:5]):\n            print(f"  组{i+1}: {len(group)} 条相似经验")\n            # 显示第一条的示例\n            idx = group[0]\n            trigger = lessons[idx].get(\'trigger\', \'\')[:50]\n            print(f"      示例: \'{trigger}...\'")\n    \n    # 合并相似经验\n    print("\\n=== 合并相似经验 ===")\n    merged_lessons = merge_similar_lessons(lessons, similar_groups)\n    print(f"合并前: {len(lessons)} 条经验")\n    print(f"合并后: {len(merged_lessons)} 条经验")\n    print(f"删除了 {len(lessons) - len(merged_lessons)} 条相似经验")\n    \n    # 创建改进计划\n    print("\\n=== 改进计划 ===")\n    improvement_plan = create_improvement_plan(patterns, len(lessons))\n    for item in improvement_plan:\n        print(f"  • {item}")\n    \n    # 保存结果\n    output_path = \'data/lessons_smart_merged.json\'\n    with open(output_path, \'w\', encoding=\'utf-8\') as f:\n        json.dump(merged_lessons, f, ensure_ascii=False, indent=2)\n    print(f"\\n智能合并后的经验库已保存到 {output_path}")\n    \n    # 保存改进计划\n    plan_path = \'data/improvement_plan.txt\'\n    with open(plan_path, \'w\', encoding=\'utf-8\') as f:\n        f.write("经验库改进计划\\n")\n        f.write("==============\\n\\n")\n        f.write(f"原始经验数: {len(lessons)}\\n")\n        f.write(f"合并后经验数: {len(merged_lessons)}\\n")\n        f.write(f"删除相似经验: {len(lessons) - len(merged_lessons)} 条\\n\\n")\n        \n        f.write("发现的问题模式:\\n")\n        for pattern, count in patterns.items():\n            f.write(f"  • {pattern}: {count} 次\\n")\n        \n        f.write("\\n改进计划:\\n")\n        for item in improvement_plan:\n            f.write(f"  • {item}\\n")\n    \n    print(f"改进计划已保存到 {plan_path}")\n\nif __name__ == \'__main__\':\n    main()'})
