2026-02-23 08:02:11 | lucid.brain | INFO | [boot_check] 工具调用: write_file({'path': 'analyze_lessons.py', 'content': '#!/usr/bin/env python3\nimport json\nimport re\nfrom collections import defaultdict, Counter\nfrom datetime import datetime\n\ndef load_lessons():\n    """加载经验库"""\n    with open(\'data/lessons.json\', \'r\', encoding=\'utf-8\') as f:\n        return json.load(f)\n\ndef analyze_lessons(lessons):\n    """分析经验库"""\n    print(f"=== 经验库分析报告 ===\\n")\n    print(f"总经验数: {len(lessons)}")\n    \n    # 按来源会话统计\n    session_counter = Counter([l.get(\'source_session\', \'unknown\') for l in lessons])\n    print(f"\\n按会话统计:")\n    for session, count in session_counter.most_common(5):\n        print(f"  {session}: {count}条")\n    \n    # 按时间分布\n    dates = []\n    for lesson in lessons:\n        created_at = lesson.get(\'created_at\', \'\')\n        if created_at:\n            date_str = created_at[:10]  # 取日期部分\n            dates.append(date_str)\n    \n    date_counter = Counter(dates)\n    print(f"\\n按日期统计:")\n    for date, count in date_counter.most_common(5):\n        print(f"  {date}: {count}条")\n    \n    # 分析触发模式\n    triggers = [l.get(\'trigger\', \'\') for l in lessons]\n    \n    # 查找相似触发\n    print(f"\\n=== 相似触发分析 ===")\n    trigger_groups = defaultdict(list)\n    \n    # 简单分组：按触发开头\n    for i, trigger in enumerate(triggers):\n        if len(trigger) > 20:\n            key = trigger[:20]  # 取前20个字符作为分组键\n            trigger_groups[key].append(i)\n    \n    # 输出可能重复的组\n    duplicate_count = 0\n    for key, indices in trigger_groups.items():\n        if len(indices) > 1:\n            duplicate_count += len(indices)\n            print(f"\\n可能重复的触发: \'{key}...\'")\n            for idx in indices[:3]:  # 只显示前3个\n                lesson = lessons[idx]\n                print(f"  - ID: {lesson.get(\'id\', \'unknown\')}")\n                print(f"    教训: {lesson.get(\'lesson\', \'\')[:50]}...")\n    \n    print(f"\\n发现 {duplicate_count} 条可能重复的经验")\n    \n    # 分析教训内容模式\n    print(f"\\n=== 教训内容分析 ===")\n    lesson_texts = [l.get(\'lesson\', \'\') for l in lessons]\n    \n    # 分类统计\n    categories = defaultdict(int)\n    for text in lesson_texts:\n        if \'弱点\' in text or \'改进\' in text:\n            categories[\'反思经验\'] += 1\n        elif \'不对\' in text or \'错误\' in text:\n            categories[\'用户纠正\'] += 1\n        elif \'老师\' in text or \'教学\' in text:\n            categories[\'老师教学\'] += 1\n        elif \'工具\' in text or \'失败\' in text:\n            categories[\'工具失败\'] += 1\n        else:\n            categories[\'其他\'] += 1\n    \n    print("按内容分类:")\n    for category, count in categories.items():\n        print(f"  {category}: {count}条")\n    \n    # 查找矛盾经验\n    print(f"\\n=== 矛盾经验检测 ===")\n    contradictions = []\n    \n    # 简单检测：相同触发但不同教训\n    trigger_to_lessons = defaultdict(list)\n    for lesson in lessons:\n        trigger = lesson.get(\'trigger\', \'\')\n        lesson_text = lesson.get(\'lesson\', \'\')\n        if trigger:\n            trigger_to_lessons[trigger].append((lesson.get(\'id\', \'\'), lesson_text))\n    \n    for trigger, lessons_list in trigger_to_lessons.items():\n        if len(lessons_list) > 1:\n            # 检查教训内容是否矛盾\n            lessons_texts = [text for _, text in lessons_list]\n            if len(set(lessons_texts)) > 1:\n                contradictions.append((trigger, lessons_list))\n    \n    print(f"发现 {len(contradictions)} 组矛盾经验")\n    for i, (trigger, lessons_list) in enumerate(contradictions[:3]):  # 只显示前3组\n        print(f"\\n矛盾组 {i+1}:")\n        print(f"触发: {trigger[:50]}...")\n        for lesson_id, lesson_text in lessons_list:\n            print(f"  - ID: {lesson_id}")\n            print(f"    教训: {lesson_text[:50]}...")\n    \n    return {\n        \'total\': len(lessons),\n        \'duplicates\': duplicate_count,\n        \'contradictions\': len(contradictions),\n        \'categories\': dict(categories)\n    }\n\ndef clean_lessons(lessons):\n    """清理经验库：去重、合并矛盾"""\n    print(f"\\n=== 开始清理经验库 ===")\n    \n    # 按触发分组\n    trigger_groups = defaultdict(list)\n    for lesson in lessons:\n        trigger = lesson.get(\'trigger\', \'\')\n        trigger_groups[trigger].append(lesson)\n    \n    cleaned = []\n    removed_count = 0\n    \n    for trigger, group in trigger_groups.items():\n        if len(group) == 1:\n            cleaned.append(group[0])\n        else:\n            # 多个相同触发，需要合并\n            print(f"\\n合并触发: \'{trigger[:50]}...\'")\n            \n            # 选择最新的经验（按创建时间）\n            sorted_group = sorted(group, \n                                 key=lambda x: x.get(\'created_at\', \'\'), \n                                 reverse=True)\n            \n            # 保留最新的一个\n            latest = sorted_group[0]\n            cleaned.append(latest)\n            \n            # 记录被移除的\n            removed = sorted_group[1:]\n            removed_count += len(removed)\n            \n            print(f"  保留: ID={latest.get(\'id\')}, 创建于={latest.get(\'created_at\', \'\')[:10]}")\n            print(f"  移除: {len(removed)} 条旧经验")\n    \n    print(f"\\n清理完成:")\n    print(f"  原始数量: {len(lessons)}")\n    print(f"  清理后: {len(cleaned)}")\n    print(f"  移除: {removed_count}")\n    \n    return cleaned\n\ndef save_cleaned_lessons(lessons, filename=\'data/lessons_cleaned.json\'):\n    """保存清理后的经验库"""\n    with open(filename, \'w\', encoding=\'utf-8\') as f:\n        json.dump(lessons, f, ensure_ascii=False, indent=2)\n    print(f"\\n已保存清理后的经验库到: {filename}")\n    return filename\n\ndef main():\n    """主函数"""\n    print("开始分析经验库...")\n    \n    # 加载数据\n    lessons = load_lessons()\n    \n    # 分析\n    stats = analyze_lessons(lessons)\n    \n    # 清理\n    cleaned = clean_lessons(lessons)\n    \n    # 保存清理后的版本\n    cleaned_file = save_cleaned_lessons(cleaned)\n    \n    # 生成报告\n    print(f"\\n=== 最终报告 ===")\n    print(f"原始经验数: {stats[\'total\']}")\n    print(f"清理后经验数: {len(cleaned)}")\n    print(f"移除重复: {stats[\'duplicates\']} 条")\n    print(f"解决矛盾: {stats[\'contradictions\']} 组")\n    print(f"经验分类: {stats[\'categories\']}")\n    \n    # 建议\n    print(f"\\n=== 学习建议 ===")\n    print("1. 定期清理经验库，避免重复")\n    print("2. 重点关注\'反思经验\'和\'工具失败经验\'")\n    print("3. 将最佳实践提取为固定模式")\n    print("4. 建立错误模式库，避免重复犯错")\n\nif __name__ == \'__main__\':\n    main()'})
