 for j, msg in enumerate(messages, 1):\n            role_display = "用户" if msg["role"] == "user" else "助手"\n            round_num = (j + 1) // 2  # 计算轮次\n            print(f"第{round_num}轮 [{role_display}]: {msg[\'content\'][:100]}...")\n            if j < len(messages):\n                print("-" * 30)\n        \n        # 打印API统计信息\n        print("\\n" + "=" * 60)\n        print("API调用统计:")\n        print("=" * 60)\n        print(f"总请求次数: {len(conversation_flow)}")\n        print(f"总消息数: {len(messages)}")\n        print(f"总token数: {response_data.get(\'total_duration\', 0)}")\n        \n        return True\n        \n    except urllib.error.URLError as e:\n        print(f"连接错误: {e}")\n        print("请确保:")\n        print("1. Ollama正在运行 (ollama serve)")\n        print("2. 模型已下载 (ollama pull qwen3:0.6b)")\n        print("3. 端口11434可用")\n        return False\n    except Exception as e:\n        print(f"其他错误: {e}")\n        return False\n\ndef interactive_chat():\n    """交互式多轮对话"""\n    url = "http://localhost:11434/api/chat"\n    messages = []\n    \n    print("交互式Ollama聊天 (输入 \'退出\' 或 \'exit\' 结束)")\n    print("=" * 60)\n    \n    try:\n        while True:\n            user_input = input("\\n你: ").strip()\n            \n            if user_input.lower() in [\'退出\', \'exit\', \'quit\', \'q\']:\n                print("对话结束。")\n                break\n            \n            # 添加用户消息\n            messages.append({\n                "role": "user",\n                "content": user_input\n            })\n            \n            # 准备请求\n            data = {\n                "model": "qwen3:0.6b",\n                "messages": messages,\n                "stream": False\n            }\n            \n            json_data = json.dumps(data).encode(\'utf-8\')\n            \n            req = urllib.request.Request(\n                url,\n                data=json_data,\n                headers={\'Content-Type\': \'application/json\'}\n            )\n            \n            # 发送请求\n            print("正在思考...", end="", flush=True)\n            response = urllib.request.urlopen(req, timeout=20)\n            response_data = json.loads(response.read().decode(\'utf-8\'))\n            \n            # 获取回复\n            assistant_reply = response_data.get(\'message\', {}).get(\'content\', \'无回复内容\')\n            print(f"\\n助手: {assistant_reply}")\n            \n            # 添加助手回复\n            messages.append({\n                "role": "assistant",\n                "content": assistant_reply\n            })\n            \n            # 显示对话轮次\n            print(f"[对话历史: {len(messages)//2} 轮]")\n        \n        # 保存对话记录\n        if messages:\n            save_conversation(messages)\n        \n        return True\n        \n    except urllib.error.URLError as e:\n        print(f"\\n连接错误: {e}")\n        return False\n    except KeyboardInterrupt:\n        print("\\n\\n用户中断对话。")\n        return True\n    except Exception as e:\n        print(f"\\n错误: {e}")\n        return False\n\ndef save_conversation(messages):\n    """保存对话记录到文件"""\n    import datetime\n    \n    timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")\n    filename = f"conversation_{timestamp}.json"\n    \n    try:\n        with open(filename, \'w\', encoding=\'utf-8\') as f:\n            json.dump({\n                "timestamp": timestamp,\n                "model": "qwen3:0.6b",\n                "messages": messages\n            }, f, ensure_ascii=False, indent=2)\n        \n        print(f"\\n对话已保存到: {filename}")\n        return True\n    except Exception as e:\n        print(f"保存对话失败: {e}")\n        return False\n\nif __name__ == "__main__":\n    print("Ollama多轮对话演示")\n    print("=" * 60)\n    print("1. 预设对话流程演示")\n    print("2. 交互式对话")\n    print("=" * 60)\n    \n    choice = input("请选择模式 (1/2): ").strip()\n    \n    if choice == "1":\n        print("\\n开始预设对话流程...")\n        success = chat_with_history()\n        if success:\n            print("\\n预设对话完成！")\n        else:\n            print("\\n预设对话失败。")\n    elif choice == "2":\n        print("\\n开始交互式对话...")\n        success = interactive_chat()\n        if success:\n            print("\\n交互式对话结束。")\n        else:\n            print("\\n交互式对话失败。")\n    else:\n        print("无效选择，使用预设对话流程。")\n        success = chat_with_history()\n        if success:\n            print("\\n预设对话完成！")\n        else:\n            print("\\n预设对话失败。")'})
