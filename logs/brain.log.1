2026-02-24 07:38:51 | lucid.brain | INFO | [task_1c81e3e8] 工具调用: write_file({'path': 'scripts/ollama_multi_chat.py', 'content': '#!/usr/bin/env python3\n"""\nOllama 多轮对话脚本\n使用 /api/chat 接口支持消息历史\n"""\n\nimport json\nimport requests\nimport time\nimport sys\n\ndef chat_with_ollama(model="gemma3", messages=None, stream=False):\n    """\n    与 Ollama 进行对话\n    \n    Args:\n        model: 模型名称\n        messages: 消息历史列表，格式为 [{"role": "user", "content": "..."}, ...]\n        stream: 是否使用流式响应\n    \n    Returns:\n        dict: 响应数据\n    """\n    url = "http://localhost:11434/api/chat"\n    \n    payload = {\n        "model": model,\n        "messages": messages,\n        "stream": stream\n    }\n    \n    try:\n        response = requests.post(url, json=payload, timeout=30)\n        response.raise_for_status()\n        return response.json()\n    except requests.exceptions.RequestException as e:\n        print(f"请求失败: {e}")\n        return None\n    except json.JSONDecodeError as e:\n        print(f"JSON 解析失败: {e}")\n        return None\n\ndef main():\n    """主函数：执行两轮对话并打印完整记录"""\n    print("=== Ollama 多轮对话演示 ===")\n    print(f"开始时间: {time.strftime(\'%Y-%m-%d %H:%M:%S\')}")\n    print()\n    \n    # 第一轮对话\n    print("=== 第一轮对话 ===")\n    first_message = "你好！请介绍一下你自己。"\n    print(f"用户: {first_message}")\n    \n    messages = [\n        {"role": "user", "content": first_message}\n    ]\n    \n    response1 = chat_with_ollama(model="gemma3", messages=messages, stream=False)\n    \n    if not response1:\n        print("第一轮对话失败")\n        return\n    \n    assistant_reply1 = response1.get("message", {}).get("content", "")\n    print(f"助手: {assistant_reply1}")\n    print()\n    \n    # 将助手的回复添加到消息历史中\n    messages.append({"role": "assistant", "content": assistant_reply1})\n    \n    # 第二轮对话\n    print("=== 第二轮对话 ===")\n    second_message = "谢谢你的介绍！你能告诉我如何学习编程吗？"\n    print(f"用户: {second_message}")\n    \n    # 添加第二轮用户消息\n    messages.append({"role": "user", "content": second_message})\n    \n    response2 = chat_with_ollama(model="gemma3", messages=messages, stream=False)\n    \n    if not response2:\n        print("第二轮对话失败")\n        return\n    \n    assistant_reply2 = response2.get("message", {}).get("content", "")\n    print(f"助手: {assistant_reply2}")\n    print()\n    \n    # 将第二轮助手的回复添加到消息历史中\n    messages.append({"role": "assistant", "content": assistant_reply2})\n    \n    # 打印完整对话记录\n    print("=== 完整对话记录 ===")\n    print(f"对话轮数: {len(messages)} 条消息")\n    print()\n    \n    for i, msg in enumerate(messages, 1):\n        role_display = "用户" if msg["role"] == "user" else "助手"\n        print(f"{i}. [{role_display}]: {msg[\'content\']}")\n        print()\n    \n    # 打印统计信息\n    print("=== 统计信息 ===")\n    print(f"第一轮响应时间: {response1.get(\'total_duration\', 0) / 1_000_000_000:.2f} 秒")\n    print(f"第二轮响应时间: {response2.get(\'total_duration\', 0) / 1_000_000_000:.2f} 秒")\n    print(f"第一轮生成token数: {response1.get(\'eval_count\', 0)}")\n    print(f"第二轮生成token数: {response2.get(\'eval_count\', 0)}")\n    \n    # 保存对话记录到文件\n    timestamp = time.strftime("%Y%m%d_%H%M%S")\n    filename = f"ollama_chat_history_{timestamp}.json"\n    \n    with open(filename, "w", encoding="utf-8") as f:\n        json.dump({\n            "model": "gemma3",\n            "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),\n            "messages": messages,\n            "responses": [response1, response2]\n        }, f, ensure_ascii=False, indent=2)\n    \n    print(f"\\n对话记录已保存到: {filename}")\n\nif __name__ == "__main__":\n    # 检查 Ollama 是否运行\n    try:\n        test_response = requests.get("http://localhost:11434/api/tags", timeout=5)\n        if test_response.status_code == 200:\n            main()\n        else:\n            print("Ollama 服务未正常运行")\n            sys.exit(1)\n    except requests.exceptions.RequestException:\n        print("无法连接到 Ollama 服务，请确保 Ollama 正在运行")\n        print("启动命令: ollama serve")\n        sys.exit(1)'})
