2026-02-23 20:09:00 | lucid.brain | INFO | [task_79b6e229] 工具调用: write_file({'path': 'analyze_lessons.py', 'content': '#!/usr/bin/env python3\n"""\n分析经验库，找出重复模式和改进点\n用于执行"变得更聪明、减少错误、更好地理解用户"任务\n"""\n\nimport json\nimport re\nfrom collections import Counter\nfrom pathlib import Path\n\ndef load_lessons():\n    """加载经验库数据"""\n    lessons_path = Path("data/lessons.json")\n    if not lessons_path.exists():\n        print("❌ 经验库文件不存在")\n        return []\n    \n    try:\n        with open(lessons_path, \'r\', encoding=\'utf-8\') as f:\n            data = json.load(f)\n        return data.get("lessons", [])\n    except Exception as e:\n        print(f"❌ 加载经验库失败: {e}")\n        return []\n\ndef analyze_patterns(lessons):\n    """分析经验模式"""\n    print(f"\\n📊 经验库分析报告")\n    print(f"总经验数: {len(lessons)}")\n    \n    # 按触发词分类\n    triggers = [lesson.get(\'trigger\', \'\') for lesson in lessons]\n    trigger_counter = Counter(triggers)\n    \n    print(f"\\n🔍 重复触发词分析:")\n    for trigger, count in trigger_counter.most_common(10):\n        if count > 1:\n            print(f"  {trigger[:60]}... ×{count}")\n    \n    # 按教训内容分类\n    lessons_text = [lesson.get(\'lesson\', \'\') for lesson in lessons]\n    \n    # 提取关键词\n    keywords = []\n    for lesson in lessons_text:\n        # 提取中文关键词\n        chinese_words = re.findall(r\'[\\u4e00-\\u9fff]{2,}\', lesson)\n        keywords.extend(chinese_words)\n    \n    keyword_counter = Counter(keywords)\n    print(f"\\n📝 高频关键词:")\n    for word, count in keyword_counter.most_common(15):\n        print(f"  {word}: {count}")\n    \n    # 分析失败模式\n    failure_patterns = []\n    for lesson in lessons:\n        trigger = lesson.get(\'trigger\', \'\')\n        lesson_text = lesson.get(\'lesson\', \'\')\n        \n        if any(word in trigger.lower() or word in lesson_text.lower() \n               for word in [\'失败\', \'错误\', \'不会\', \'无法\', \'不能\', \'wrong\', \'error\', \'fail\']):\n            failure_patterns.append({\n                \'trigger\': trigger,\n                \'lesson\': lesson_text[:100]\n            })\n    \n    print(f"\\n❌ 失败模式分析 (共{len(failure_patterns)}条):")\n    for i, pattern in enumerate(failure_patterns[:10], 1):\n        print(f"  {i}. {pattern[\'trigger\'][:60]}...")\n        print(f"     教训: {pattern[\'lesson\']}")\n    \n    # 分析用户偏好\n    user_pref_patterns = []\n    for lesson in lessons:\n        trigger = lesson.get(\'trigger\', \'\')\n        lesson_text = lesson.get(\'lesson\', \'\')\n        \n        if any(word in trigger.lower() or word in lesson_text.lower() \n               for word in [\'用户\', \'喜欢\', \'偏好\', \'记住\', \'下次\', \'以后\', \'user\', \'prefer\']):\n            user_pref_patterns.append({\n                \'trigger\': trigger,\n                \'lesson\': lesson_text[:100]\n            })\n    \n    print(f"\\n👤 用户偏好分析 (共{len(user_pref_patterns)}条):")\n    for i, pattern in enumerate(user_pref_patterns[:10], 1):\n        print(f"  {i}. {pattern[\'trigger\'][:60]}...")\n        print(f"     偏好: {pattern[\'lesson\']}")\n    \n    return {\n        \'total_lessons\': len(lessons),\n        \'duplicate_triggers\': [(k, v) for k, v in trigger_counter.items() if v > 1],\n        \'failure_patterns\': failure_patterns,\n        \'user_pref_patterns\': user_pref_patterns,\n        \'top_keywords\': keyword_counter.most_common(20)\n    }\n\ndef generate_improvement_plan(analysis):\n    """生成改进计划"""\n    print(f"\\n🎯 改进计划")\n    print("=" * 60)\n    \n    # 1. 减少重复错误\n    if analysis[\'duplicate_triggers\']:\n        print(f"\\n1️⃣ 减少重复错误:")\n        print(f"   发现 {len(analysis[\'duplicate_triggers\'])} 个重复触发模式")\n        print(f"   建议: 加强经验检索，在回答前检查是否有类似失败经验")\n    \n    # 2. 改进失败处理\n    if analysis[\'failure_patterns\']:\n        print(f"\\n2️⃣ 改进失败处理:")\n        print(f"   发现 {len(analysis[\'failure_patterns\'])} 个失败模式")\n        print(f"   建议: 创建失败模式库，遇到类似问题时自动应用解决方案")\n        \n        # 提取常见失败类型\n        failure_types = {}\n        for pattern in analysis[\'failure_patterns\']:\n            trigger = pattern[\'trigger\']\n            if \'工具\' in trigger:\n                failure_types[\'工具失败\'] = failure_types.get(\'工具失败\', 0) + 1\n            elif \'不会\' in trigger or \'无法\' in trigger:\n                failure_types[\'知识不足\'] = failure_types.get(\'知识不足\', 0) + 1\n            elif \'错误\' in trigger:\n                failure_types[\'执行错误\'] = failure_types.get(\'执行错误\', 0) + 1\n        \n        print(f"   失败类型分布:")\n        for ftype, count in failure_types.items():\n            print(f"     - {ftype}: {count}次")\n    \n    # 3. 增强用户理解\n    if analysis[\'user_pref_patterns\']:\n        print(f"\\n3️⃣ 增强用户理解:")\n        print(f"   发现 {len(analysis[\'user_pref_patterns\'])} 个用户偏好记录")\n        print(f"   建议: 创建用户偏好数据库，在回答时主动应用已知偏好")\n    \n    # 4. 基于关键词的学习重点\n    print(f"\\n4️⃣ 学习重点:")\n    print(f"   高频关键词:")\n    for word, count in analysis[\'top_keywords\'][:10]:\n        print(f"     - {word} ({count}次)")\n    \n    # 5. 具体行动项\n    print(f"\\n5️⃣ 具体行动项:")\n    print(f"   ✅ 立即执行:")\n    print(f"     1. 修改学习模块，增加经验有效性评分")\n    print(f"     2. 创建用户偏好记忆文件")\n    print(f"     3. 优化经验检索算法，提高相关性")\n    \n    print(f"\\n   📅 短期目标 (1-2天):")\n    print(f"     1. 实现失败模式自动匹配")\n    print(f"     2. 增加成功经验记录")\n    print(f"     3. 创建学习进度跟踪")\n    \n    print(f"\\n   🎯 长期目标:")\n    print(f"     1. 实现自我优化循环")\n    print(f"     2. 建立预测性学习")\n    print(f"     3. 达到下一成长阶段 (需要95条新经验)")\n\ndef main():\n    """主函数"""\n    print("🧠 LucidMind 学习分析工具")\n    print("=" * 60)\n    \n    lessons = load_lessons()\n    if not lessons:\n        print("❌ 没有找到经验数据")\n        return\n    \n    analysis = analyze_patterns(lessons)\n    generate_improvement_plan(analysis)\n    \n    # 保存分析结果\n    output_path = Path("data/learning_analysis.json")\n    try:\n        with open(output_path, \'w\', encoding=\'utf-8\') as f:\n            json.dump(analysis, f, ensure_ascii=False, indent=2)\n        print(f"\\n💾 分析结果已保存到: {output_path}")\n    except Exception as e:\n        print(f"❌ 保存分析结果失败: {e}")\n\nif __name__ == "__main__":\n    main()'})
