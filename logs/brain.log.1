2026-02-23 19:58:34 | lucid.brain | INFO | [task_bafc2d77] 工具调用: write_file({'path': 'analyze_lessons.py', 'content': '#!/usr/bin/env python3\nimport json\nimport re\nfrom collections import Counter, defaultdict\n\ndef analyze_lessons():\n    # 读取经验库\n    with open(\'data/lessons.json\', \'r\', encoding=\'utf-8\') as f:\n        lessons = json.load(f)\n    \n    print(f"总经验数: {len(lessons)}")\n    print("=" * 60)\n    \n    # 分析触发词频率\n    triggers = [lesson[\'trigger\'] for lesson in lessons]\n    trigger_counter = Counter(triggers)\n    \n    print("重复触发词统计:")\n    for trigger, count in trigger_counter.most_common(20):\n        if count > 1:\n            print(f"  {count}次: {trigger[:80]}...")\n    \n    print("\\n" + "=" * 60)\n    \n    # 分析经验内容模式\n    tool_patterns = defaultdict(int)\n    error_patterns = defaultdict(int)\n    \n    for lesson in lessons:\n        # 分析工具使用模式\n        if \'工具\' in lesson[\'trigger\'] or \'tool\' in lesson[\'trigger\'].lower():\n            tool_patterns[\'工具相关\'] += 1\n            \n        # 分析错误类型\n        lesson_text = lesson[\'lesson\'].lower()\n        if \'失败\' in lesson_text or \'error\' in lesson_text:\n            error_patterns[\'失败/错误\'] += 1\n        if \'坐标\' in lesson_text or \'超出屏幕\' in lesson_text:\n            error_patterns[\'坐标超出\'] += 1\n        if \'参数\' in lesson_text:\n            error_patterns[\'参数错误\'] += 1\n        if \'搜索\' in lesson_text:\n            error_patterns[\'需要搜索\'] += 1\n        if \'换方法\' in lesson_text:\n            error_patterns[\'需要换方法\'] += 1\n    \n    print("工具使用模式统计:")\n    for pattern, count in tool_patterns.items():\n        print(f"  {pattern}: {count}次")\n    \n    print("\\n错误模式统计:")\n    for pattern, count in error_patterns.items():\n        print(f"  {pattern}: {count}次")\n    \n    print("\\n" + "=" * 60)\n    \n    # 提取最佳实践\n    best_practices = []\n    for lesson in lessons:\n        if \'应\' in lesson[\'lesson\'] or \'应该\' in lesson[\'lesson\'] or \'建议\' in lesson[\'lesson\']:\n            best_practices.append(lesson[\'lesson\'])\n    \n    print(f"最佳实践数量: {len(best_practices)}")\n    print("\\n前10条最佳实践:")\n    for i, practice in enumerate(best_practices[:10], 1):\n        print(f"{i}. {practice[:100]}...")\n    \n    # 生成改进建议\n    print("\\n" + "=" * 60)\n    print("改进建议:")\n    \n    if error_patterns.get(\'坐标超出\', 0) > 0:\n        print("1. 坐标超出问题频繁出现 → 建议：在执行GUI操作前先检查屏幕分辨率")\n    \n    if error_patterns.get(\'参数错误\', 0) > 0:\n        print("2. 参数错误频繁出现 → 建议：创建参数验证函数，使用前先验证")\n    \n    if error_patterns.get(\'需要搜索\', 0) > 0:\n        print("3. 需要搜索的情况多 → 建议：建立常见问题知识库，减少重复搜索")\n    \n    if error_patterns.get(\'需要换方法\', 0) > 0:\n        print("4. 需要换方法的情况多 → 建议：建立替代方案库，遇到失败时快速选择替代方案")\n    \n    # 计算重复率\n    unique_triggers = len(set(triggers))\n    duplicate_rate = (len(triggers) - unique_triggers) / len(triggers) * 100\n    print(f"\\n重复率分析: {len(triggers)-unique_triggers}/{len(triggers)} ({duplicate_rate:.1f}%) 的触发词重复")\n\nif __name__ == "__main__":\n    analyze_lessons()'})
